---
/* Reduced footer for the standalone "Jawort by Jansen" page.
   Keeps what a visitor legally and practically needs — contact, socials,
   Impressum/Datenschutz/AGB — without the site-wide column navigation
   that would pull them back into the rest of VitaLunaris. */
const year = new Date().getFullYear();

const legalLinks = [
  { href: '/impressum', label: 'Impressum' },
  { href: '/datenschutz', label: 'Datenschutz' },
  { href: '/agb', label: 'AGB' },
];
---

<footer class="jwfooter">
  <div class="jwfooter__inner">
    <div class="jwfooter__top">
      <div class="jwfooter__brand">
        <span class="jwfooter__brand-name">Jawort</span>
        <span class="jwfooter__brand-sub">by Jansen · Theresia Jansen</span>
      </div>

      <div class="jwfooter__contact">
        <a class="jwfooter__row" href="mailto:info@vitalunaris.ch">
          <span class="jwfooter__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="M2 7l10 7 10-7" />
            </svg>
          </span>
          <span>info@vitalunaris.ch</span>
        </a>

        <a class="jwfooter__row" href="tel:+41792917402">
          <span class="jwfooter__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" />
            </svg>
          </span>
          <span>+41 792 917 402</span>
        </a>

        <div class="jwfooter__row">
          <span class="jwfooter__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-7 8-13a8 8 0 10-16 0c0 6 8 13 8 13z" />
              <circle cx="12" cy="9" r="3" />
            </svg>
          </span>
          <span>Eichenaustrasse 32, CH-9470 Buchs</span>
        </div>
      </div>

      <div class="jwfooter__social">
        <span class="jwfooter__social-label">Follow us</span>
        <div class="jwfooter__social-icons">
          <a href="https://www.facebook.com/JansenBuchs/" target="_blank" rel="noopener noreferrer" class="jwfooter__social-icon" aria-label="Facebook">
            <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
              <path d="M18.5 16h3l.5-4h-3.5V9.5c0-1.2.4-2 2-2h1.5v-3.4C21.7 4 20.5 4 19.4 4c-3 0-5 1.8-5 5v3H11v4h3.4V28h4.1V16z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/vitalunaris_by_jansen/" target="_blank" rel="noopener noreferrer" class="jwfooter__social-icon jwfooter__social-icon--outline" aria-label="Instagram">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="6" y="6" width="20" height="20" rx="5" />
              <circle cx="16" cy="16" r="5" />
              <circle cx="22" cy="10" r="1" fill="currentColor" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="jwfooter__credits">
      <hr class="jwfooter__divider" />
      <div class="jwfooter__credits-row">
        <p class="jwfooter__copy">{year} Jawort by Jansen · ein Angebot von VitaLunaris</p>
        <ul class="jwfooter__legal">
          <li>
            <a href="/" class="jwfooter__link jwfooter__link--external">
              VitaLunaris
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M2.5 7.5L7.5 2.5M7.5 2.5H3.5M7.5 2.5V6.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
          {legalLinks.map(({ href, label }) => (
            <li><a href={href} class="jwfooter__link">{label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .jwfooter {
    background: var(--c-cherrywood);
    color: var(--c-spring-wood);
    padding: 48px 20px 32px;
  }
  @media (min-width: 768px)  { .jwfooter { padding: 64px 32px 40px; } }
  @media (min-width: 1280px) { .jwfooter { padding: 80px 60px 48px; } }

  .jwfooter__inner {
    max-width: 1740px;
    margin: 0 auto;
  }

  .jwfooter__top {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .jwfooter__top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 48px;
    }
  }

  /* ---------- Brand ---------- */
  .jwfooter__brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .jwfooter__brand-name {
    font-family: 'ES Park', serif;
    font-weight: var(--weight-regular);
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  @media (min-width: 768px) { .jwfooter__brand-name { font-size: 34px; } }
  .jwfooter__brand-sub {
    font-family: 'ES Park', serif;
    font-size: 15px;
    line-height: 1.4;
    opacity: 0.7;
  }

  /* ---------- Contact ---------- */
  .jwfooter__contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .jwfooter__row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: 'ES Park', serif;
    font-size: 15px;
    line-height: 1.5;
    color: var(--c-spring-wood);
    text-decoration: none;
    transition: opacity 200ms ease;
  }
  a.jwfooter__row:hover { opacity: 0.7; }

  .jwfooter__icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 1px;
  }
  .jwfooter__icon svg { width: 100%; height: 100%; display: block; }

  /* ---------- Social ---------- */
  .jwfooter__social {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .jwfooter__social-label {
    font-family: 'ES Park', serif;
    font-size: 15px;
    opacity: 0.7;
  }
  .jwfooter__social-icons {
    display: flex;
    gap: 12px;
  }
  .jwfooter__social-icon {
    display: inline-flex;
    width: 32px;
    height: 32px;
    color: var(--c-spring-wood);
    transition: opacity 200ms ease;
  }
  .jwfooter__social-icon:hover { opacity: 0.7; }
  .jwfooter__social-icon svg { width: 100%; height: 100%; display: block; }

  /* ---------- Credits ---------- */
  .jwfooter__credits { margin-top: 40px; }
  .jwfooter__divider {
    border: 0;
    border-top: 1px solid rgba(249, 244, 238, 0.25);
    margin: 0 0 20px;
  }
  .jwfooter__credits-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .jwfooter__credits-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
  }
  .jwfooter__copy {
    font-family: 'ES Park', serif;
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.7;
    margin: 0;
  }
  .jwfooter__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .jwfooter__link {
    font-family: 'ES Park', serif;
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-spring-wood);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 200ms ease;
  }
  .jwfooter__link:hover { opacity: 1; }
  .jwfooter__link--external {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .jwfooter__link--external svg {
    flex-shrink: 0;
    transform: translateY(-1px);
  }
</style>
