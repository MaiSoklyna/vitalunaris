---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@organisms/Hero.astro';
import NarrativeBlock from '@organisms/NarrativeBlock.astro';
import InfoCardsRow from '@organisms/InfoCardsRow.astro';
import Heading from '@atoms/Heading.astro';
import Text from '@atoms/Text.astro';
import Button from '@atoms/Button.astro';

/* ----- "Alles was Du wissen musst." — fact cards ----- */
/* Soul Circle 2027: jeder Abend einzeln buchbar (kein Abo). Je Termin ein Labs-Formular
   mit eigenem Produkt (CHF 130). */
const termine = [
  { date: '2027-01-11', label: 'Mo, 11. Januar', lang: 'Montag, 11. Januar 2027', embed: '-7TyAhPNVAPtngpSs4mEfA' },
  { date: '2027-02-08', label: 'Mo, 8. Februar', lang: 'Montag, 8. Februar 2027', embed: 'yjxIY2MnHbv08tXl9XM5Cw' },
  { date: '2027-03-08', label: 'Mo, 8. März', lang: 'Montag, 8. März 2027', embed: 'BvaQXwhlMfDNDvJSYdWsGA' },
  { date: '2027-04-12', label: 'Mo, 12. April', lang: 'Montag, 12. April 2027', embed: 'Wzn7mLLnUdFnhDtIA7Cr0g' },
  { date: '2027-05-03', label: 'Mo, 3. Mai', lang: 'Montag, 3. Mai 2027', embed: 'ls4QCS3g4Au8ge2ctn4CRw' },
  { date: '2027-06-14', label: 'Mo, 14. Juni', lang: 'Montag, 14. Juni 2027', embed: 'Hx0IUMxfpjkhtFWiHT7Ijw' },
  { date: '2027-07-05', label: 'Mo, 5. Juli', lang: 'Montag, 5. Juli 2027', embed: 'ESyqivi5p2OM1j1cbZP74w' },
  { date: '2027-08-09', label: 'Mo, 9. August', lang: 'Montag, 9. August 2027', embed: 'T2F664lhDfr7XYYZmSNA_w' },
  { date: '2027-09-13', label: 'Mo, 13. September', lang: 'Montag, 13. September 2027', embed: 'Ljyuu0137HieW4zb9GVbwg' },
  { date: '2027-10-11', label: 'Mo, 11. Oktober', lang: 'Montag, 11. Oktober 2027', embed: 'YM98B9k3cnqKbYbKKt7cLA' },
  { date: '2027-11-08', label: 'Mo, 8. November', lang: 'Montag, 8. November 2027', embed: 'gPwKNhymQfIN3ibclPsDcQ' },
  { date: '2027-12-13', label: 'Mo, 13. Dezember', lang: 'Montag, 13. Dezember 2027', embed: 'j6HhaAxWHVzxxrtRwVK7TQ' },
];

const infoCards = [
  { eyebrow: 'Rhythmus', body: 'Einmal im Monat, online' },
  { eyebrow: 'Für wen', body: 'Alle, die schon bei Theresia aufgestellt haben' },
  { eyebrow: 'Investition', body: 'CHF 130.– pro Abend, einzeln buchbar' },
];
---

<BaseLayout
  title="Systemic SoulCircle — monatlich dranbleiben | VitaLunaris"
  description="Der Systemic SoulCircle: einmal im Monat online zusammenkommen — ein Thema, kleine Aufstellungen, Impulse und Übungen. CHF 130.– pro Abend, einzeln buchbar."
  currentPath="/aufstellen/systemic-soulcircle"
>
  <Hero
    eyebrow="Systemic SoulCircle"
    title="Dranbleiben,<br />ohne allein zu sein."
    subtitle="Nach einem Modul ist vieles in Bewegung — und dann? Im SoulCircle kommen wir einmal im Monat online zusammen: ein Thema, kleine Aufstellungen, Impulse und Übungen.<br /><br />Kein neuer Kurs, den Du Dir überlegen musst. Ein Ort, an dem Du einfach weiter dabei bist."
    ctaText="Termin wählen — CHF 130.– pro Abend"
    ctaHref="#anmelden"
    image="/images/ausbildung/aufstellung-theresia.jpg"
    imageFocus="center center"
  />

  {/* ===================== Narrative — lavender gradient ===================== */}
  <NarrativeBlock
    tone="lavender-gradient"
    imageSide="left"
    image="/images/ausbildung/aufstellung-figur.jpg"
    imageAlt="Theresia Jansen beim Aufstellen mit dem Systembrett"
    title="Was in Bewegung kam, darf weitergehen."
    body="Ein Modul endet, Du gehst nach Hause — und das, was sich gerade geöffnet hat, läuft weiter. Genau dort setzt der SoulCircle an.<br /><br />Einmal im Monat kommen wir online zusammen. Wir schauen auf ein Thema, machen kleine Aufstellungen, Du bekommst Impulse und Übungen für den Alltag.<br /><br />Kein Leistungsdruck, keine Hausaufgaben. Du kommst, wenn Du kannst, und steigst aus, wann Du willst."
    bulletGroups={[
      {
        heading: 'Jeden Monat:',
        items: [
          'Ein Online-Treffen zu einem bestimmten Thema',
          'Kleine Aufstellungen in der Gruppe',
          'Impulse und Übungen für zwischendurch',
          'Austausch mit Menschen, die denselben Weg gehen',
        ],
      },
    ]}
  />

  {/* ===================== Theresia Jansen — gold, image right ===================== */}
  <section class="lehrerin">
    <div class="lehrerin__inner">
      <div class="lehrerin__content">
        <Heading variant="eyebrow" class="lehrerin__eyebrow">Theresia Jansen</Heading>
        <Heading level={2} variant="h1" class="lehrerin__name">Ich bleibe an Deiner Seite.</Heading>
        <Text size="p1" class="lehrerin__body">
          Ich begleite seit über 30 Jahren Menschen in systemischer Arbeit und Heilkunde — gelebte Praxis aus der Deutschschweiz, nicht angelesen.
        </Text>
        <Text size="p1" class="lehrerin__body">
          Der SoulCircle ist mein Weg, dranzubleiben: Ich bringe jeden Monat ein Thema mit, nehme Deine Fragen auf und halte den Raum — auch für das, was zwischen den Treffen auftaucht.
        </Text>
      </div>
      <div class="lehrerin__media">
        <img src="/images/ausbildung/theresia-soulcircle.jpg" alt="Theresia Jansen" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {/* ===================== Alles was Du wissen musst. ===================== */}
  <section class="wissen">
    <div class="wissen__inner">
      <Heading level={2} variant="h1" class="wissen__title">Alles was Du wissen musst.</Heading>
    </div>
  </section>

  <InfoCardsRow cards={infoCards} />

  <section class="wissen-foot">
    <div class="wissen-foot__inner">
      <Text size="p1" class="wissen-foot__caption">
        Offen für alle, die schon bei Theresia aufgestellt haben.<br />
        Du buchst jeden Abend einzeln, ohne Abo.
      </Text>
      <div class="wissen-foot__cta">
        <Button href="#anmelden" variant="primary" size="lg" class="wissen-foot__btn">Dabei sein</Button>
      </div>
    </div>
  </section>

  {/* ===================== Termin wählen & buchen =====================
       Jeder Abend hat ein eigenes Labs-Formular mit Produkt (CHF 130).
       Die Knöpfe schalten das Formular um; vergangene Abende sind gesperrt.
       #termin-YYYY-MM-DD in der URL wählt einen Abend vor (Kalender-Links). */}
  <section class="circle-form" id="anmelden">
    <div class="circle-form__inner">
      <div class="circle-form__head">
        <Heading variant="eyebrow" class="circle-form__eyebrow">Anmeldung</Heading>
        <Heading level={2} variant="h1" class="circle-form__title">Termin wählen</Heading>
        <Text size="p1" class="circle-form__intro">
          Wähl den Abend, an dem Du dabei sein möchtest, und schliesse die Zahlung sicher über zahls.ch ab — CHF 130.– pro Abend. Danach erhältst Du alle Infos per E-Mail.
        </Text>
      </div>

      <div class="circle-dates" role="group" aria-label="Termine 2027" data-circle-dates>
        {termine.map((t) => (
          <button type="button" class="circle-dates__btn" data-date={t.date} data-embed={t.embed} data-lang={t.lang} aria-pressed="false">{t.label}</button>
        ))}
      </div>

      <p class="circle-form__chosen" data-circle-chosen></p>

      <div class="circle-form__frame-wrap">
        <iframe
          class="circle-form__frame"
          data-circle-frame
          src={`https://opus.alchemy.zuerich/api/f/${termine[0].embed}/page`}
          title="Anmeldung Soul Circle"
          loading="lazy"
          allow="payment"
        ></iframe>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var wrap = document.querySelector('[data-circle-dates]');
      if (!wrap) return;
      var btns = Array.prototype.slice.call(wrap.querySelectorAll('button'));
      var frame = document.querySelector('[data-circle-frame]');
      var chosen = document.querySelector('[data-circle-chosen]');
      var today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Zurich' }).format(new Date());
      btns.forEach(function (b) { if (b.dataset.date < today) { b.disabled = true; } });
      function pick(b) {
        if (!b || b.disabled) return;
        btns.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
        var src = 'https://opus.alchemy.zuerich/api/f/' + b.dataset.embed + '/page';
        if (frame.getAttribute('src') !== src) frame.setAttribute('src', src);
        chosen.textContent = 'Anmeldung für ' + b.dataset.lang + ', 17.00 – 20.00 Uhr';
      }
      btns.forEach(function (b) { b.addEventListener('click', function () { pick(b); }); });
      var m = location.hash.match(/termin-(\d{4}-\d{2}-\d{2})/);
      var pre = m && btns.find(function (b) { return b.dataset.date === m[1]; });
      var next = btns.find(function (b) { return !b.disabled; });
      if (!next) { chosen.textContent = 'Alle Termine 2027 sind vorbei.'; frame.hidden = true; return; }
      pick(pre && !pre.disabled ? pre : next);
      if (pre) document.getElementById('anmelden').scrollIntoView();
    })();
  </script>
</BaseLayout>

<style>
  /* ============================================================
     LEHRERIN — "Theresia Jansen" (Pale Gold, text left / image right)
     ============================================================ */
  .lehrerin { background: var(--c-pale-gold); padding: 60px 20px; }
  @media (min-width: 768px)  { .lehrerin { padding: 80px 32px; } }
  @media (min-width: 1280px) { .lehrerin { padding: 90px 60px; } }
  @media (min-width: 1920px) { .lehrerin { padding: 90px; } }

  .lehrerin__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    max-width: 1740px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) { .lehrerin__inner { flex-direction: row; align-items: center; gap: 64px; } }
  @media (min-width: 1920px) { .lehrerin__inner { gap: 100px; } }

  .lehrerin__media {
    flex: 0 0 auto;
    width: 100%;
    overflow: hidden;
    border-radius: 16.67px;
    background: rgba(96, 29, 29, 0.06);
    aspect-ratio: 4 / 5;
    order: -1;
  }
  @media (min-width: 1024px) { .lehrerin__media { width: 46%; border-radius: 20px; order: 0; } }
  @media (min-width: 1920px) { .lehrerin__media { width: 683px; border-radius: 25px; aspect-ratio: 683 / 830; } }
  .lehrerin__media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .lehrerin__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
    flex: 1 1 auto;
    min-width: 0;
  }
  @media (min-width: 1024px) { .lehrerin__content { gap: 26.67px; } }
  @media (min-width: 1920px) { .lehrerin__content { gap: 40px; max-width: 820px; } }

  .lehrerin__eyebrow { color: var(--c-cherrywood); }
  .lehrerin__name {
    color: var(--c-cherrywood);
    font-family: 'ES Park', serif;
    font-weight: var(--weight-regular);
    font-size: var(--h2-size);
    line-height: 1.1;
    margin: 0;
  }
  @media (min-width: 1920px) { .lehrerin__name { font-size: 60px; line-height: 1.1; } }
  .lehrerin__body { color: var(--c-cherrywood); font-size: var(--p1-size); line-height: 1.5; }

  /* ============================================================
     WISSEN — "Alles was Du wissen musst." (header + cards + footer)
     ============================================================ */
  .wissen { background: var(--c-spring-wood); padding: 60px 20px 32px; }
  @media (min-width: 768px)  { .wissen { padding: 80px 32px 40px; } }
  @media (min-width: 1280px) { .wissen { padding: 90px 60px 48px; } }
  @media (min-width: 1920px) { .wissen { padding: 120px 90px 64px; } }

  .wissen__inner { max-width: 1740px; margin: 0 auto; }
  .wissen__title { color: var(--c-cherrywood); text-align: center; margin: 0; }

  .wissen-foot { background: var(--c-spring-wood); padding: 8px 20px 60px; }
  @media (min-width: 768px)  { .wissen-foot { padding: 8px 32px 80px; } }
  @media (min-width: 1280px) { .wissen-foot { padding: 8px 60px 90px; } }
  @media (min-width: 1920px) { .wissen-foot { padding: 8px 90px 120px; } }

  .wissen-foot__inner {
    max-width: 1740px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }
  .wissen-foot__caption { color: var(--c-cherrywood); text-align: center; }
  .wissen-foot__link { color: inherit; text-decoration: underline; }

  .wissen-foot__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
  }
  @media (min-width: 640px) { .wissen-foot__cta { flex-direction: row; justify-content: center; gap: 20px; } }
  /* Only constrain the width on narrow screens — size and padding come from
     the shared .btn--lg token so every button on the site matches. */
  .wissen-foot__cta :global(.btn) {
    width: 100%;
    max-width: 350px;
  }
  @media (min-width: 640px) {
    /* Drop the cap too — otherwise a long label keeps hitting 320px and the
       40px side padding gets squeezed even though the token still says 40px. */
    .wissen-foot__cta :global(.btn) { width: auto; max-width: none; }
  }

  /* ============================================================
     CIRCLE FORM — Mockup-Anmeldung (Platzhalter, sendet nicht)
     ============================================================ */
  .circle-form { background: var(--c-spring-wood); padding: 60px 20px; scroll-margin-top: 100px; }
  @media (min-width: 768px)  { .circle-form { padding: 80px 32px; } }
  @media (min-width: 1280px) { .circle-form { padding: 90px 60px; } }

  .circle-form__inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .circle-form__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  .circle-form__eyebrow { color: var(--c-cherrywood); }
  .circle-form__title { color: var(--c-cherrywood); margin: 0; }
  .circle-form__intro { color: var(--c-cherrywood); margin: 0; }

  .circle-dates { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  @media (min-width: 640px) { .circle-dates { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .circle-dates__btn {
    font-family: 'ES Park', serif; font-size: var(--p2-size); color: var(--c-cherrywood);
    background: transparent; border: 1px solid var(--c-cherrywood); border-radius: 100px;
    padding: 10px 12px; cursor: pointer; transition: background 200ms ease, color 200ms ease;
  }
  .circle-dates__btn:hover:not(:disabled) { background: rgba(96, 29, 29, 0.08); }
  .circle-dates__btn[aria-pressed="true"] { background: var(--c-cherrywood); color: var(--c-spring-wood); }
  .circle-dates__btn:disabled { cursor: default; text-decoration: line-through; border-color: rgba(96, 29, 29, 0.3); color: rgba(96, 29, 29, 0.45); }
  .circle-dates__btn:focus-visible { outline: 2px solid var(--c-cherrywood); outline-offset: 2px; }
  .circle-form__chosen { margin: 0; text-align: center; color: var(--c-cherrywood); font-family: 'ES Park', serif; font-size: var(--p1-size); }
  .circle-form__frame-wrap { width: 100%; }
  .circle-form__frame {
    width: 100%;
    height: 520px;          /* sensible default before Scribe sizes it */
    min-height: 420px;
    border: 0;
    display: block;
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: height 200ms ease;
  }

</style>
