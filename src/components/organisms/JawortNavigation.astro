---
/* Reduced navigation for the standalone "Jawort by Jansen" page.
   Deliberately NOT the site-wide Navigation: this page is its own
   destination, so it carries only the brand mark, a contact CTA and a
   quiet way back to VitaLunaris. */
---

<header class="jwnav">
  <div class="jwnav__inner">
    <a href="/praxisangebote/jawort-by-jansen" class="jwnav__brand" aria-label="Jawort by Jansen – Seitenanfang">
      <span class="jwnav__brand-name">Jawort</span>
      <span class="jwnav__brand-sub">by Jansen</span>
    </a>

    <nav class="jwnav__links" aria-label="Navigation Jawort by Jansen">
      <a href="/" class="jwnav__back">
        Zu VitaLunaris
        <svg class="jwnav__external" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M2.5 7.5L7.5 2.5M7.5 2.5H3.5M7.5 2.5V6.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a href="#kontakt" class="jwnav__cta">Kontakt</a>
    </nav>
  </div>
</header>

<style>
  .jwnav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 8px 8px 12px;
  }
  @media (min-width: 768px)  { .jwnav { padding: 12px 16px 0; } }
  @media (min-width: 1280px) { .jwnav { padding: 16px 32px; } }
  @media (min-width: 1920px) { .jwnav { padding: 32px 48px 0; } }

  .jwnav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 16px;
    min-height: 40px;
    background: linear-gradient(90.11deg,
      #FFAC8A 2.9%,
      #F5E193 39.98%,
      #E1E2FC 78.48%,
      #8E84B6 108.81%),
      #F9F4EE;
    border-radius: 12px;
  }
  @media (min-width: 1024px) { .jwnav__inner { padding: 8px 20px; min-height: 48px; border-radius: 16px; } }
  @media (min-width: 1280px) { .jwnav__inner { min-height: 60px; border-radius: 20px; } }
  @media (min-width: 1920px) { .jwnav__inner { padding: 0 43px; height: 90px; border-radius: 24px; } }

  /* ---------- Brand wordmark ---------- */
  .jwnav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    text-decoration: none;
    color: var(--c-cherrywood);
    white-space: nowrap;
  }
  .jwnav__brand-name {
    font-family: 'ES Park', serif;
    font-weight: var(--weight-regular);
    font-size: 20px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  @media (min-width: 768px)  { .jwnav__brand-name { font-size: 26px; } }
  @media (min-width: 1920px) { .jwnav__brand-name { font-size: 32px; } }

  .jwnav__brand-sub {
    font-family: 'ES Park', serif;
    font-weight: var(--weight-regular);
    font-size: 12px;
    line-height: 1.2;
    opacity: 0.75;
  }
  @media (min-width: 768px)  { .jwnav__brand-sub { font-size: 15px; } }
  @media (min-width: 1920px) { .jwnav__brand-sub { font-size: 18px; } }

  /* ---------- Links ---------- */
  .jwnav__links {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  @media (min-width: 768px) { .jwnav__links { gap: 24px; } }

  .jwnav__back,
  .jwnav__cta {
    font-family: 'ES Park', serif;
    font-size: 14px;
    font-weight: var(--weight-regular);
    line-height: 1.2;
    color: var(--c-cherrywood);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 200ms ease;
  }
  @media (min-width: 768px) { .jwnav__back, .jwnav__cta { font-size: 16px; } }

  /* The way back is present but quiet — it must not compete with the CTA.
     Hover dims (like every other link on the site) instead of brightening. */
  .jwnav__back {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    opacity: 0.75;
  }
  .jwnav__back:hover { opacity: 0.45; }

  .jwnav__external {
    flex-shrink: 0;
    transform: translateY(-1px);
  }

  /* On the narrowest screens the CTA alone carries the bar. */
  @media (max-width: 419.98px) { .jwnav__back { display: none; } }

  .jwnav__cta {
    padding: 7px 16px;
    border: 1px solid var(--c-cherrywood);
    border-radius: 999px;
  }
  .jwnav__cta:hover { opacity: 0.7; }
  @media (min-width: 768px) { .jwnav__cta { padding: 9px 22px; } }
</style>
