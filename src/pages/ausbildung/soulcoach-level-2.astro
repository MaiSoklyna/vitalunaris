---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@organisms/Hero.astro';
import NarrativeBlock from '@organisms/NarrativeBlock.astro';
import InfoCardsRow from '@organisms/InfoCardsRow.astro';
import ProcessSteps from '@organisms/ProcessSteps.astro';
import CalendarBooking from '@organisms/CalendarBooking.astro';
import Faq from '@organisms/Faq.astro';
import TestimonialsBlock from '@organisms/TestimonialsBlock.astro';
import Heading from '@atoms/Heading.astro';
import Text from '@atoms/Text.astro';
import Button from '@atoms/Button.astro';
import { getEmDashEntry } from 'emdash';
import { nl2br, imageUrl, getTestimonials } from '@lib/cms';

// Editable at /_emdash/admin/content/ausbildung_programs (falls back to copy below).
const { entry } = await getEmDashEntry('ausbildung_programs', 'soulcoach-level-2');
const d: Record<string, any> = entry?.data ?? {};

/* Shared CTA labels (used in several sections) */
const CTA_ANMELDEN = d.hero_primary_cta_text || 'Kostenloses Erstgespräch vereinbaren';
const CTA_ERSTGESPRAECH = 'Kostenloses Erstgespräch vereinbaren';
const CTA_HREF = d.hero_primary_cta_href || '#termin';

/* ----- "In den drei Monaten tauchen wir tief in:" — outcomes arc (4 modules) ----- */
const outcomes = d.outcomes?.length ? d.outcomes : [
  {
    title: 'Modul 1 — Aufstellen & Wahrnehmen',
    description: 'Das Aufstellungsbrett, Raumaufstellungen und Bodenanker: Du lernst, systemische Prozesse sichtbar zu machen, Dynamiken im Raum wahrzunehmen und Aufstellungen sicher anzuleiten.',
  },
  {
    title: 'Modul 2 — Nervensystem & Tiefe',
    description: 'Wie Veränderungsprozesse auf das Nervensystem wirken, wie Du Intuition und systemische Wahrnehmung verbindest — und Menschen sicher durch emotionale Prozesse begleitest.',
  },
  {
    title: 'Modul 3 — Energie & Ahnenlinien',
    description: 'Energetische Dynamiken erkennen, Ahnenlinien einbeziehen und auch bei komplexen oder herausfordernden Themen den Überblick behalten.',
  },
  {
    title: 'Modul 4 — Prozessführung & Abschluss',
    description: 'Du entwickelst Deinen eigenen Stil als Coach, gewinnst Sicherheit in der Gesprächsführung und integrierst alle Inhalte für Deine eigenständige Arbeit.',
  },
];

/* ----- "Nach dieser Ausbildung arbeitest Du anders." — Ergebnis (4 Karten) ----- */
const results = d.results?.length ? d.results : [
  {
    title: 'Du siehst Systeme.',
    description: 'Muster, Dynamiken, Loyalitäten — Du erkennst sie früher. In der Arbeit mit anderen, und in Deinem eigenen Leben.',
  },
  {
    title: 'Du begleitest sicher.',
    description: 'Nicht nur auf der Oberfläche — sondern dort wo sich wirklich etwas hält. Mit Methode und Haltung.',
  },
  {
    title: 'Du hältst die Spannung.',
    description: 'Konflikte, Widerstand, schwierige Momente — Du weichst nicht aus. Du bist Boden für andere.',
  },
  {
    title: 'Du arbeitest aus Erfahrung.',
    description: 'Nicht aus Theorie. Was Du weitergibst, hast Du selbst durchlebt. Das ist der Unterschied.',
  },
];

/* ----- Stimmen von Teilnehmer:innen — star reviews ----- */
const _reviews = await getTestimonials('ausbildung');
const reviews = _reviews.length ? _reviews : [
  {
    quote: '«Diese Ausbildung hat mir eine völlig neue Perspektive eröffnet. Ich war lange eher im Kopf als im Körper — genau das beginnt sich zu verändern. Die Arbeit mit Familienkonstellationen hat mir geholfen, Klarheit zu gewinnen. Wo vorher Chaos war, entsteht heute mehr Ruhe und Vertrauen. Ich fühle mich mehr bei mir selbst angekommen.»',
    name: 'Jana L.',
  },
  {
    quote: '«In dieser Ausbildungsgruppe fühle ich mich so getragen, dass ich mit allem da sein kann, was ich bin. So habe ich mich in einer Gruppe noch nie gefühlt. In mir ist eine grosse Welle in Bewegung gekommen — früher hätte ich solche Gefühle verdrängt, heute gehe ich durch sie hindurch. Diese Ausbildung ist für mich weit mehr als Lernen. Sie ist ein Raum für Heilung, Wachstum und echtes Menschsein.»',
    name: 'Silvia F.',
  },
  {
    quote: '«Diese Ausbildung zeigt die Magie des systemischen Aufstellens — und ich könnte mir keinen Ort vorstellen, an dem ich mich wohler fühle. Ein geschützter Raum, in dem jede einfach sie selbst sein darf. Theresia schafft diesen Rahmen mit einer einfühlsamen Art, die es möglich macht, sich wirklich zu öffnen. Was diese Ausbildung besonders macht: die Erfahrung, selbst Teil eines solchen Prozesses zu sein.»',
    name: 'Corina B.',
  },
];

/* ----- "Alles was Du wissen musst." — fact cards ----- */
const infoCards = d.info_cards?.length ? d.info_cards : [
  { eyebrow: 'Start', body: 'Einmal jährlich — im September' },
  { eyebrow: 'Format', body: 'Geschlossener Block, 3 Monate' },
  { eyebrow: 'Durchführung', body: 'Hybrid — Präsenz + online, max. 6 Personen' },
  { eyebrow: 'Investition', body: 'CHF 3’800.–' },
];

/* ----- FAQ — first 4 fill the left column, next 4 the right ----- */
const faqItems = d.faq_items?.length ? d.faq_items : [
  { question: 'Was kann ich danach?', answer: 'Du leitest eigene systemische Aufstellungsgruppen — Einzelarbeit wie Gruppenformate. Du kennst die Methode, kannst Dynamiken lesen und weisst, wie Du einen Prozess sicher hältst.' },
  { question: 'Welche Voraussetzung gibt es?', answer: 'Alle drei Soulwork-Module. Du kannst nur dorthin begleiten, wo Du selbst schon warst — deshalb steht die eigene Erfahrung am Anfang. Eine vergleichbare Selbsterfahrung anderswo ist nach Rücksprache möglich.' },
  { question: 'Bekomme ich ein Zertifikat?', answer: 'Ja. Nach erfolgreichem Abschluss erhältst Du ein Zertifikat als Systemic Soulcoach.' },
  { question: 'Kann ich damit selbständig arbeiten?', answer: 'Ja. Als eigene Praxis oder integriert in Deine bestehende Tätigkeit — als Beraterin, Therapeutin, Coach oder in der Begleitung von Teams.' },
  { question: 'Wann startet die Ausbildung?', answer: 'Einmal im Jahr, jeweils im September. Die Gruppe geht die drei Monate gemeinsam durch — einen Zwischeneinstieg gibt es nicht.' },
  { question: 'Wie ist die Ausbildung aufgebaut?', answer: 'Ein geschlossener Block über drei Monate — nicht einzeln buchbar. Die Gruppe geht den ganzen Weg zusammen: Aufstellen & Wahrnehmen, Nervensystem & Tiefe, Energie & Ahnenlinien, Prozessführung & Abschluss. Du leitest von Anfang an selbst, begleitet und mit Feedback.' },
  { question: 'Kann ich rein online teilnehmen?', answer: 'Nein. Eine Gruppe zu leiten lernst Du nur im Raum mit echten Menschen. Die Präsenztage sind fester Bestandteil, ergänzt durch Online-Termine.' },
  { question: 'Wie gross ist die Gruppe?', answer: 'Maximal 6 Personen. So kommt jede:r oft genug in die Leitungsrolle.' },
  { question: 'Was kostet die Ausbildung?', answer: 'CHF 3’800.–. Ratenzahlung ist möglich — die Details besprechen wir im Erstgespräch.' },
];
---

<BaseLayout
  title="Systemic Soulcoach — Ausbildung zur Aufstellungsleitung | VitaLunaris"
  description="Die Ausbildung zum Systemic Soulcoach bei Theresia Jansen — lerne, eigene systemische Aufstellungsgruppen zu leiten. Mit Methode, Haltung und über 30 Jahren Praxiserfahrung."
  currentPath="/ausbildung/soulcoach-level-2"
>
  <Hero
    eyebrow={d.hero_eyebrow || 'Ausbildung · Systemic Soulcoach'}
    title={d.hero_title || 'Leite Deine eigenen<br />Aufstellungs&shy;gruppen.'}
    subtitle={d.hero_subtitle || 'Für alle, die systemisches Aufstellen nicht nur erleben, sondern selbst anleiten wollen. Du lernst, Gruppen sicher zu führen, Dynamiken im Raum zu lesen und Menschen verantwortungsvoll durch tiefe Prozesse zu begleiten.<br /><br />Drei Monate als geschlossene Gruppe. Am Ende leitest Du Deine eigenen Aufstellungsgruppen — als eigene Praxis oder als Teil Deiner bestehenden Arbeit.'}
    ctaText={CTA_ANMELDEN}
    ctaHref={CTA_HREF}
    image={imageUrl(d.hero_image) || '/images/placeholder/Placeholder-8.jpg'}
  />

  {/* ===================== Narrative — gold gradient ===================== */}
  <NarrativeBlock
    tone="light"
    imageSide="left"
    image={imageUrl(d.narrative_image) || '/images/placeholder/Placeholder-11.jpg'}
    imageAlt=""
    title={d.narrative_title || 'Eine Aufstellung zu leiten heisst, den Raum zu halten.'}
    body={nl2br(d.narrative_body) || 'Vielleicht kennst Du das Gefühl, wenn eine Aufstellung kippt und plötzlich etwas Echtes sichtbar wird. Diesen Moment zu halten — dafür braucht es mehr als eine Methode.<br /><br />Du lernst, Gruppen sicher zu führen: Dynamiken wahrnehmen, im richtigen Moment eingreifen und im richtigen Moment nichts tun. Sicherheit in der Gesprächsführung, auch wenn es emotional wird. Und die Verantwortung, die dazugehört, wenn Menschen sich vor Dir öffnen.<br /><br />Es geht nicht darum, eine Technik auswendig zu lernen. Sondern darum, Deinen eigenen Stil als Leiterin zu finden.'}
  />

  {/* ===================== In den drei Monaten — outcomes arc ===================== */}
  <section class="outcomes">
    <header class="outcomes__header">
      <Heading level={2} variant="h1" class="outcomes__title">{d.outcomes_title || 'Was Du in den drei Monaten lernst:'}</Heading>
    </header>

    {/* Desktop (≥1024px): single curve + absolutely positioned cards at ≥1072 */}
    <div class="outcomes__desktop">
      <img src="/images/ebene/process-curve.svg" alt="" class="outcomes__curve" />
      <div class="outcomes__cards">
        {outcomes.map((o, i) => (
          <article class={`outcomes__card outcomes__card--${i + 1}`}>
            <Heading level={3} class="outcomes__card-title">{o.title}</Heading>
            <Text size="p1" class="outcomes__card-body">{o.description}</Text>
          </article>
        ))}
      </div>
    </div>

    {/* Mobile/tablet (<1024px): two halves, each with its own curve + 2 cards */}
    <div class="outcomes__mobile">
      {[0, 2].map((startIdx) => (
        <div class="outcomes__mobile-section">
          <div class="outcomes__mobile-curve">
            <img
              src={startIdx === 0 ? '/images/ebene/process-curve-1.svg' : '/images/ebene/process-curve-2.svg'}
              alt=""
            />
          </div>
          <div class="outcomes__mobile-cards">
            {outcomes.slice(startIdx, startIdx + 2).map((o) => (
              <article class="outcomes__mobile-card">
                <Heading level={3} class="outcomes__card-title">{o.title}</Heading>
                <Text size="p1" class="outcomes__card-body">{o.description}</Text>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="outcomes__cta">
      <Button href={CTA_HREF} variant="primary" size="lg">{CTA_ANMELDEN}</Button>
    </div>
  </section>

  {/* ===================== Was Dich nach der Ausbildung erwartet ===================== */}
  <NarrativeBlock
    tone="light"
    imageSide="left"
    image={imageUrl(d.narrative2_image) || '/images/placeholder/Placeholder-13.jpg'}
    imageAlt=""
    title={d.narrative2_title || 'Und danach?'}
    body={nl2br(d.narrative2_body) || 'Du erhältst ein Zertifikat als Systemic Soulcoach und kannst eigene Aufstellungsgruppen leiten — als eigene Praxis oder integriert in Deine bestehende Arbeit als Beraterin, Therapeutin oder Coach.'}
  />

  {/* ===================== Nach dieser Ausbildung arbeitest Du anders. ===================== */}
  <section class="outcomes outcomes--results">
    <header class="outcomes__header">
      <Heading level={2} variant="h1" class="outcomes__title">Nach dieser Ausbildung arbeitest Du anders.</Heading>
    </header>

    <div class="outcomes__desktop">
      <img src="/images/ebene/process-curve.svg" alt="" class="outcomes__curve" />
      <div class="outcomes__cards">
        {results.map((o, i) => (
          <article class={`outcomes__card outcomes__card--${i + 1}`}>
            <Heading level={3} class="outcomes__card-title">{o.title}</Heading>
            <Text size="p1" class="outcomes__card-body">{o.description}</Text>
          </article>
        ))}
      </div>
    </div>

    <div class="outcomes__mobile">
      {[0, 2].map((startIdx) => (
        <div class="outcomes__mobile-section">
          <div class="outcomes__mobile-curve">
            <img
              src={startIdx === 0 ? '/images/ebene/process-curve-1.svg' : '/images/ebene/process-curve-2.svg'}
              alt=""
            />
          </div>
          <div class="outcomes__mobile-cards">
            {results.slice(startIdx, startIdx + 2).map((o) => (
              <article class="outcomes__mobile-card">
                <Heading level={3} class="outcomes__card-title">{o.title}</Heading>
                <Text size="p1" class="outcomes__card-body">{o.description}</Text>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* ===================== Stimmen aus der Ausbildung ===================== */}
  <TestimonialsBlock title="Was Teilnehmer:innen sagen" testimonials={reviews} tone={d.testimonials_tone || 'spring-wood'} />

  {/* ===================== Theresia Jansen — gold band, image right ===================== */}
  <section class="lehrerin">
    <div class="lehrerin__inner">
      <div class="lehrerin__content">
        <Heading variant="eyebrow" class="lehrerin__eyebrow">{d.lehrerin_eyebrow || 'Theresia Jansen'}</Heading>
        <Heading level={2} variant="h1" class="lehrerin__name">{d.lehrerin_title || 'Das Handwerk von jemandem, der es täglich lebt.'}</Heading>
        <Text size="p1" class="lehrerin__body"><Fragment set:html={nl2br(d.lehrerin_body) || 'Ich lehre nicht, was ich gelesen habe — sondern was ich über 30 Jahre hinweg erprobt, durchlebt und verfeinert habe. Kein importiertes Curriculum, sondern echte Praxis mit echten Menschen in der Deutschschweiz.<br/><br/>Hier begegne ich Dir direkter und fordernder: als Kollegin, die Dich in die Leitungsrolle bringt und Dir ehrlich zurückmeldet, was ich sehe.'} /></Text>
      </div>
      <div class="lehrerin__media">
        <img src={imageUrl(d.lehrerin_image) || '/images/placeholder/placeholder-4.jpg'} alt="Theresia Jansen" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {/* ===================== So kommst Du rein ===================== */}
  <ProcessSteps
    title="So kommst Du rein"
    steps={[
      { number: '1', title: 'Vorgespräch', description: 'Wir schauen gemeinsam, ob Du bereit bist für die Leitungsrolle — und ob es für uns beide passt.', color: 'purple' },
      { number: '2', title: 'Anmeldung', description: 'Wenn es stimmt, sicherst Du Dir Deinen Platz in der Gruppe.', color: 'raspberry' },
      { number: '3', title: 'Loslegen', description: 'Du erhältst alle Zugänge und startest am nächsten Startdatum.', color: 'aurora' },
    ]}
    ctaText={CTA_ERSTGESPRAECH}
    ctaHref={CTA_HREF}
  />

  {/* ===================== Alles was Du wissen musst. ===================== */}
  <section class="wissen">
    <div class="wissen__inner">
      <Heading level={2} variant="h1" class="wissen__title">Alles was Du wissen musst.</Heading>
    </div>
  </section>

  <InfoCardsRow cards={infoCards} />

  <section class="wissen-foot">
    <div class="wissen-foot__inner">
      <Text size="p1" class="wissen-foot__caption">
        <Fragment set:html={d.schedule_caption || 'Voraussetzung: alle drei Soulwork-Module — oder eine vergleichbare systemische Selbsterfahrung nach Rücksprache. Die Ausbildung läuft als geschlossener Block über drei Monate.'} />
      </Text>
      <div class="wissen-foot__cta">
        <Button href={CTA_HREF} variant="primary" size="lg" class="wissen-foot__btn">{CTA_ANMELDEN}</Button>
      </div>
    </div>
  </section>

  {/* ===================== Termin buchen ===================== */}
  <CalendarBooking
    slug="soulcoach-level-2-gespraech"
    eyebrow="Dein Gespräch"
    title="Lass uns sprechen"
    intro="45 Minuten, kostenlos und unverbindlich. Aufbau, Voraussetzungen — und ob Du bereit bist für die Leitungsrolle."
  />

  {/* ===================== FAQ ===================== */}
  <Faq title="FAQ" items={faqItems} />

  {/* ===================== Infoanlass — dark CTA with form ===================== */}
  <section class="infoanlass">
    <div class="infoanlass__card">
      <div class="infoanlass__content">
        <Heading variant="eyebrow" class="infoanlass__eyebrow">{d.infoanlass_eyebrow || 'Infoanlass'}</Heading>
        <Heading level={2} variant="h1" class="infoanlass__title"><Fragment set:html={d.infoanlass_title || 'Komm zum<br />nächsten Infoanlass.'} /></Heading>
        <Text size="p1" class="infoanlass__body">{d.infoanlass_body || 'Ein kostenloser Online-Abend via Zoom: ehrlicher Einblick in die Arbeit, den Aufbau — und Raum für Deine Fragen.'}</Text>
        <a href="/ausbildung/infoanlaesse#anmelden" class="infoanlass__submit infoanlass__cta">Zum Infoanlass anmelden</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Testimonials-Hintergrund ist jetzt im Admin wählbar (Feld „Stimmen · Hintergrund"). */
</style>

<style>
  /* ============================================================
     OUTCOMES — "In den drei Monaten tauchen wir tief ein:"
     (dome arc, 4 cards + CTA).
     Mobile/tablet (<1024): two halves with separate curves (-1, -2)
     Desktop (≥1024): single process-curve.svg
     Desktop++ (≥1072): cards + CTA absolutely positioned per Figma
     ============================================================ */
  .outcomes {
    background: var(--c-spring-wood);
    padding: 64px 8px;
    overflow: hidden;
  }
  @media (min-width: 768px)  { .outcomes { padding: 96px 8px; } }
  @media (min-width: 1024px) { .outcomes { padding: 120px 8px; } }

  .outcomes__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 12px;
    max-width: 1106px;
    margin: 0 auto;
  }
  .outcomes__title { text-align: center; color: var(--c-cherrywood); margin: 0; }

  .outcomes__card-title {
    font-family: 'ES Park', serif;
    font-weight: var(--weight-regular);
    font-size: var(--h3-size);
    line-height: 1.2;
    color: var(--c-cherrywood);
    margin: 0;
  }
  .outcomes__card-body { color: var(--c-cherrywood); font-size: var(--p1-size); line-height: 1.5; }

  .outcomes__cta {
    display: flex;
    justify-content: center;
    padding: 24px 12px 0;
  }

  .outcomes__desktop { display: none; }
  .outcomes__mobile  { display: block; margin-top: 24px; }

  @media (min-width: 1024px) {
    .outcomes__desktop { display: block; margin-top: 32px; }
    .outcomes__mobile  { display: none; }
    .outcomes__curve { display: block; width: 100%; height: auto; margin: 0; }
  }

  @media (min-width: 1024px) and (max-width: 1071.98px) {
    .outcomes__cards {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
      padding: 0 90px;
      margin-top: 40px;
      min-height: 0;
      box-sizing: border-box;
    }
    .outcomes__card {
      position: static;
      width: auto;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      color: var(--c-cherrywood);
    }
  }

  @media (min-width: 1072px) {
    .outcomes {
      position: relative;
      --cv: min(100vw, 1920px);
      --cx: calc((100vw - var(--cv)) / 2);
      min-height: calc(0.68177 * var(--cv));
      padding: 120px 0;
    }
    .outcomes__header { max-width: 1106px; padding: 0 12px; margin: 0 auto; }

    .outcomes__desktop {
      position: static;
      width: 100%;
      max-width: 1920px;
      margin: 32px auto 0;
    }
    .outcomes__curve { max-width: none; }
    .outcomes__cards { position: static; display: block; padding: 0; margin: 0; }

    .outcomes__card {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(16px, 2.1vw, 40px);
      color: var(--c-cherrywood);
    }
    .outcomes__card--1 { left: calc(var(--cx) + 0.05000 * var(--cv)); top: calc(0.37344 * var(--cv)); width: calc(0.20104 * var(--cv)); }
    .outcomes__card--2 { left: calc(var(--cx) + 0.27552 * var(--cv)); top: calc(0.29792 * var(--cv)); width: calc(0.20104 * var(--cv)); }
    .outcomes__card--3 { left: calc(var(--cx) + 0.50677 * var(--cv)); top: calc(0.28958 * var(--cv)); width: calc(0.20000 * var(--cv)); }
    .outcomes__card--4 { left: calc(var(--cx) + 0.73698 * var(--cv)); top: calc(0.38177 * var(--cv)); width: calc(0.20000 * var(--cv)); }

    .outcomes__card-title { font-size: clamp(24px, 2.1vw, 40px); line-height: 1.15; }
    .outcomes__card-body  { font-size: clamp(16px, 1.2vw, 23px); line-height: 1.5; }

    .outcomes__cta {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      top: calc(0.59583 * var(--cv));
      padding: 0;
      justify-content: center;
    }
  }

  .outcomes__mobile-section { margin-top: 24px; }
  .outcomes__mobile-section:first-child { margin-top: 0; }

  .outcomes__mobile-curve {
    width: auto;
    aspect-ratio: 600 / 130;
    overflow: visible;
    margin-left: -8px;
    margin-right: -8px;
    padding: 0;
    box-sizing: content-box;
  }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .outcomes__mobile-curve { padding-top: 16px; }
  }
  .outcomes__mobile-curve img { display: block; width: 100%; height: 100%; }

  .outcomes__mobile-cards {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 16px 12px 0;
  }
  @media (min-width: 480px) and (max-width: 1023.98px) {
    .outcomes__mobile-cards {
      flex-direction: row;
      gap: 28px;
      padding: 24px 12px 0;
      align-items: flex-start;
    }
    .outcomes__mobile-cards > .outcomes__mobile-card {
      flex: 1 1 0;
      min-width: 0;
      max-width: calc(50% - 14px);
    }
  }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .outcomes__mobile-cards { gap: 44px; padding: 32px 44px 0; }
    .outcomes__mobile-cards > .outcomes__mobile-card { max-width: calc(50% - 22px); }
  }

  .outcomes__mobile-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    text-align: left;
    color: var(--c-cherrywood);
  }
  @media (min-width: 768px) { .outcomes__mobile-card { gap: 26.67px; } }

  /* ============================================================
     LEHRERIN — "Theresia Jansen" (Pale Gold, text left / image right)
     ============================================================ */
  .lehrerin { background: var(--c-pale-gold); padding: 60px 20px; }
  @media (min-width: 768px)  { .lehrerin { padding: 80px 32px; } }
  @media (min-width: 1280px) { .lehrerin { padding: 90px 60px; } }
  @media (min-width: 1920px) { .lehrerin { padding: 90px; } }

  .lehrerin__inner {
