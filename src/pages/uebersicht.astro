---
import BaseLayout from '@layouts/BaseLayout.astro';
import OverviewHero from '@organisms/OverviewHero.astro';
import NarrativeBlock from '@organisms/NarrativeBlock.astro';
import Faq from '@organisms/Faq.astro';
import NewsletterBlock from '@organisms/NewsletterBlock.astro';
import TestimonialsBlock from '@organisms/TestimonialsBlock.astro';
import Heading from '@atoms/Heading.astro';
import Text from '@atoms/Text.astro';
import Button from '@atoms/Button.astro';

/* ----- "Drei Stufen, ein Weg" — three stage cards (image + eyebrow + title + body + CTA) ----- */
const stages = [
  {
    image: '/images/cards/card-1.jpg', 
    eyebrow: 'Systemic Soulwork',
    title: 'Für Dich selbst',
    body: 'Verstehen, warum sich bestimmte Dinge in Deinem Leben wiederholen. Drei Module à ca. einen Monat, einzeln buchbar — Arbeit an Deinem eigenen System, keine Ausbildung.',
    ctaHref: '/ausbildung/soulcoach-level-1',
  },
  {
    image: '/images/cards/card-2.jpg',
    eyebrow: 'Systemic Soulcoach',
    title: 'Um andere zu begleiten',
    body: 'Die Ausbildung für alle, die eigene Aufstellungsgruppen leiten wollen. Drei Monate als geschlossene Gruppe. Voraussetzung: alle drei Soulwork-Module.',
    ctaHref: '/ausbildung/soulcoach-level-2',
  },
  {
    image: '/images/cards/card-3.jpg',
    eyebrow: 'Systemic SoulCircle',
    title: 'Zum Dranbleiben',
    body: 'Einmal im Monat online zusammenkommen: ein Thema, kleine Aufstellungen, Impulse und Übungen — dazwischen über Telegram verbunden. Ab dem ersten Soulwork-Modul, CHF 130.– im Monat.',
    ctaHref: '/ausbildung/begleitung-kreis',
  },
];

/* ----- "Was systemisches Aufstellen ist." — outcomes arc (4 cards) ----- */
const outcomes = [
  {
    title: 'Was unsichtbar war, wird sichtbar.',
    description: 'In einer Aufstellung siehst Du Dein System vor Dir stehen — und plötzlich ergibt Sinn, was sich jahrelang wie ein Rätsel angefühlt hat.',
  },
  {
    title: 'Es geht nie nur um Dich.',
    description: 'Was sich immer wiederholt, sitzt selten nur in einer Person. Familie, Herkunft, Muster über Generationen — das System wirkt mit.',
  },
  {
    title: 'Verstehen statt analysieren.',
    description: 'Du erarbeitest Dir nichts im Kopf. Du stellst auf, Du spürst — und begreifst dadurch, was Worte nicht erklären können.',
  },
  {
    title: 'Aus über 30 Jahren Praxis.',
    description: 'Kein importiertes Curriculum. Was hier weitergegeben wird, ist mit echten Menschen in der Deutschschweiz erprobt.',
  },
];

/* ----- Stimmen von Teilnehmer:innen — star reviews ----- */
const reviews = [
  {
    quote: '«Diese Ausbildung hat mir eine völlig neue Perspektive eröffnet. Ich war lange eher im Kopf als im Körper — genau das beginnt sich zu verändern. Die Arbeit mit Familienkonstellationen hat mir geholfen, Klarheit zu gewinnen. Wo vorher Chaos war, entsteht heute mehr Ruhe und Vertrauen. Ich fühle mich mehr bei mir selbst angekommen.»',
    name: 'Jana L.',
  },
  {
    quote: '«In dieser Ausbildungsgruppe fühle ich mich so getragen, dass ich mit allem da sein kann, was ich bin. So habe ich mich in einer Gruppe noch nie gefühlt. In mir ist eine grosse Welle in Bewegung gekommen — früher hätte ich solche Gefühle verdrängt, heute gehe ich durch sie hindurch. Diese Ausbildung ist für mich weit mehr als Lernen. Sie ist ein Raum für Heilung, Wachstum und echtes Menschsein.»',
    name: 'Silvia F.',
  },
  {
    quote: '«Diese Ausbildung zeigt die Magie des systemischen Aufstellens — und ich könnte mir keinen Ort vorstellen, an dem ich mich wohler fühle. Ein geschützter Raum, in dem jede einfach sie selbst sein darf. Theresia schafft diesen Rahmen mit einer einfühlsamen Art, die es möglich macht, sich wirklich zu öffnen. Was diese Ausbildung besonders macht: die Erfahrung, selbst Teil eines solchen Prozesses zu sein.»',
    name: 'Corina B.',
  },
];

const faqItems = [
  {
    question: 'Womit fange ich an?',
    answer: 'Mit Systemic Soulwork. Dort arbeitest Du an Deinem eigenen System — das ist die Grundlage für alles Weitere. Ob Du danach die Ausbildung machst, entscheidest Du später.',
  },
  {
    question: 'Was ist der Unterschied zwischen Soulwork und der Soulcoach-Ausbildung?',
    answer: 'Soulwork ist Arbeit an Dir selbst: Du verstehst Dein eigenes System. Die Soulcoach-Ausbildung ist Handwerk: Du lernst, eigene Aufstellungsgruppen zu leiten. Voraussetzung dafür sind alle drei Soulwork-Module.',
  },
  {
    question: 'Brauche ich Vorkenntnisse?',
    answer: 'Nein. Du musst keine therapeutische oder psychologische Vorbildung mitbringen. Wichtiger sind Offenheit und die Bereitschaft, Dein eigenes System wirklich anzuschauen.',
  },
  {
    question: 'Muss ich am Ende andere begleiten wollen?',
    answer: 'Nein. Die meisten kommen für sich selbst. Systemic Soulwork ist in sich abgeschlossen — die Ausbildung ist eine Möglichkeit, keine Erwartung.',
  },
  {
    question: 'Ist das eher theoretisch oder praktisch?',
    answer: 'Klar praktisch. Du lernst durch Erleben — Du stellst auf und wirst aufgestellt. Die nötige Theorie ordnet das Erlebte ein, der Schwerpunkt liegt auf der Erfahrung in der Gruppe.',
  },
  {
    question: 'Eignet sich das auch für Menschen, die schon mit Menschen arbeiten?',
    answer: 'Sehr. Wenn Du im Gesundheits-, Coaching- oder Beratungsbereich tätig bist, gibt Dir die systemische Perspektive ein zusätzliches Werkzeug — Du erkennst Muster und Dynamiken früher.',
  },
  {
    question: 'Werden die Kosten von der Krankenkasse übernommen?',
    answer: 'Systemisches Aufstellen ist eine Form der persönlichen und beruflichen Entwicklung und in der Regel keine kassenpflichtige Leistung.',
  },
  {
    question: 'Was, wenn ich einen Termin nicht wahrnehmen kann?',
    answer: 'Das lässt sich in der Regel lösen. Sprich uns einfach frühzeitig an — wir finden gemeinsam einen Weg, damit Du den Anschluss nicht verlierst.',
  },
];
---

<BaseLayout
  title="Systemisches Aufstellen — Übersicht | VitaLunaris"
  description="Systemisches Aufstellen bei VitaLunaris: Systemic Soulwork für Dich selbst, die Ausbildung zum Systemic Soulcoach für die Leitung eigener Gruppen und der SoulCircle zum Dranbleiben. Über 30 Jahre gelebte Praxis in der Deutschschweiz."
  currentPath="/uebersicht"
>
  <OverviewHero
    graphic="/images/ebene/Ebene-14.svg"
    eyebrow="Systemisches Aufstellen"
    title="Systemisches Aufstellen.<br />Für Dich — oder<br />für Deine Arbeit."
    subtitle="Manche kommen, um sich selbst zu verstehen. Andere, um eigene Aufstellungsgruppen zu leiten. Drei Wege, ein Fundament — über 30 Jahre gelebte Praxis in der Deutschschweiz."
  />

  {/* ===================== Methode. Haltung. Tiefe. ===================== */}
  <NarrativeBlock
    tone="lavender-gradient"
    imageSide="left"
    image="/images/placeholder/Placeholder-7.jpg"
    imageAlt=""
    title="Methode.<br />Haltung. Tiefe."
    body="Systemische Arbeit schaut nicht auf die Person allein — sondern auf das System dahinter. Die Familie, die Geschichte, die Muster die von Generation zu Generation weitergehen ohne je ausgesprochen zu werden.<br/> <br/> Was sich im Leben einer Person immer wiederholt, sitzt selten nur in ihr. In einer Aufstellung wird sichtbar, was sonst unsichtbar bleibt — ob Du damit Dein eigenes System anschaust oder andere darin begleitest."
  />

  {/* ===================== Drei Stufen, ein Weg ===================== */}
  <section class="stages">
    <div class="stages__inner">
      <div class="stages__header">
        <Heading level={2} variant="h1" class="stages__title">Drei Wege</Heading>
        <Text size="p1" class="stages__intro">
          Du wählst, was zu Dir passt. Systemic Soulwork ist der Einstieg — von dort führt der Weg weiter, wenn Du möchtest.
        </Text>
      </div>
      <div class="stages__grid">
        {stages.map((s) => (
          <article class="stage-card">
            <div class="stage-card__media">
              <img src={s.image} alt="" loading="lazy" decoding="async" />
            </div>
            <div class="stage-card__text">
              <Heading variant="eyebrow" class="stage-card__eyebrow">{s.eyebrow}</Heading>
              <Heading level={3} variant="h2" class="stage-card__title">{s.title}</Heading>
              <Text size="p1" class="stage-card__body">{s.body}</Text>
            </div>
            <div class="stage-card__cta">
              <Button href={s.ctaHref} variant="primary" size="lg" fullWidth>Mehr erfahren</Button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ===================== Was systemisches Aufstellen ist. ===================== */}
  <section class="outcomes">
    <header class="outcomes__header">
      <Heading level={2} variant="h1" class="outcomes__title">Was systemisches Aufstellen ist.</Heading>
    </header>

    {/* Desktop (≥1024px): single curve + absolutely positioned cards at ≥1072 */}
    <div class="outcomes__desktop">
      <img src="/images/ebene/process-curve.svg" alt="" class="outcomes__curve" />
      <div class="outcomes__cards">
        {outcomes.map((o, i) => (
          <article class={`outcomes__card outcomes__card--${i + 1}`}>
            <Heading level={3} class="outcomes__card-title">{o.title}</Heading>
            <Text size="p1" class="outcomes__card-body">{o.description}</Text>
          </article>
        ))}
      </div>
    </div>

    {/* Mobile/tablet (<1024px): two halves, each with its own curve + 2 cards */}
    <div class="outcomes__mobile">
      {[0, 2].map((startIdx) => (
        <div class="outcomes__mobile-section">
          <div class="outcomes__mobile-curve">
            <img
              src={startIdx === 0 ? '/images/ebene/process-curve-1.svg' : '/images/ebene/process-curve-2.svg'}
              alt=""
            />
          </div>
          <div class="outcomes__mobile-cards">
            {outcomes.slice(startIdx, startIdx + 2).map((o) => (
              <article class="outcomes__mobile-card">
                <Heading level={3} class="outcomes__card-title">{o.title}</Heading>
                <Text size="p1" class="outcomes__card-body">{o.description}</Text>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* ===================== Deine Lehrerin — Theresia Jansen ===================== */}
  <section class="lehrerin">
    <div class="lehrerin__inner">
      <div class="lehrerin__media">
        <img src="/images/placeholder/Placeholder-8.jpg" alt="Theresia Jansen" loading="lazy" decoding="async" />
      </div>
      <div class="lehrerin__content">
        <Heading variant="eyebrow" class="lehrerin__eyebrow">Deine Lehrerin</Heading>
        <Heading level={2} variant="h1" class="lehrerin__name">Theresia Jansen</Heading>
        <Text size="p1" class="lehrerin__body">
         Über 30 Jahre Erfahrung in der Begleitung von Menschen – körperlich, systemisch und energetisch.
        </Text>
        <Text size="p1" class="lehrerin__body">
          Ich lehre nicht, was ich gelesen habe — sondern was ich über 30 Jahre hinweg erprobt, durchlebt und verfeinert habe. Kein importiertes Curriculum, sondern echte Praxis mit echten Menschen in der Deutschschweiz.
        </Text>
         <Text size="p1" class="lehrerin__body">
          Ob Du für Dich selbst kommst oder um andere zu begleiten: Für viele wird diese Arbeit zu einer persönlichen Reise, die weit über das Fachliche hinausgeht.
        </Text>
        <div class="lehrerin__cta">
          <Button href="/ueber-uns" variant="primary" size="lg">Mehr über Theresia</Button>
        </div>
      </div>
    </div>
  </section>

  {/* ===================== Stimmen ===================== */}
  <TestimonialsBlock title="Was Teilnehmer:innen sagen" testimonials={reviews} />

  {/* ===================== Gold claim / quote ===================== */}
  <section class="uquote">
    <div class="uquote__inner">
      <div class="uquote__media">
        <img src="/images/placeholder/Placeholder-5.jpg" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="uquote__content">
        <Heading level={2} variant="h1" class="uquote__text">
          „Menschen verändern sich nicht, weil man ihnen sagt, was sie tun sollen. Sie verändern sich, wenn sie beginnen zu verstehen, was sie bisher unbewusst getragen hat.“
        </Heading>
        <Text size="p1" class="uquote__attribution">Theresia Jansen · VitaLunaris</Text>
      </div>
    </div>
  </section>

  {/* ===================== FAQ ===================== */}
  <Faq title="FAQ" items={faqItems} />

  {/* ===================== Noch nicht sicher? — Newsletter ===================== */}
  <NewsletterBlock
    title="Noch nicht sicher?"
    body="Melde Dich für den Newsletter an — wir informieren Dich über die nächsten Starttermine. Und in der Zwischenzeit laden wir Dich ein, in einem unserer Seminare zu schnuppern."
    placeholder="E-mail Adresse"
    submitText="Anmelden"
  />
</BaseLayout>

<style>
  /* ============================================================
     STAGES — "Drei Stufen, ein Weg" (image + eyebrow + title + body + CTA)
     ============================================================ */
  .stages {
    background: var(--c-spring-wood);
    padding: 64px 20px;
  }
  @media (min-width: 768px)  { .stages { padding: 96px 32px; } }
  @media (min-width: 1280px) { .stages { padding: 120px 60px; } }
  @media (min-width: 1920px) { .stages { padding: 90px; } }

  .stages__inner {
    max-width: 1740px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }
  @media (min-width: 1920px) { .stages__inner { gap: 64px; } }

  .stages__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
    width: 100%;
    max-width: 862px;
  }
  @media (min-width: 768px) { .stages__header { gap: 40px; } }

  .stages__title { color: var(--c-cherrywood); margin: 0; text-align: center; width: 100%; }
  .stages__intro { color: var(--c-cherrywood); text-align: center; width: 100%; }

  .stages__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    width: 100%;
  }
  @media (min-width: 768px)  { .stages__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1280px) { .stages__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; } }

  .stage-card {
    box-sizing: border-box;
    background: var(--c-spring-wood);
    border: 1px solid var(--c-cherrywood);
    border-radius: 16.67px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    height: 100%;
  }
  @media (min-width: 1280px) { .stage-card { padding: 24px; gap: 32px; border-radius: 20px; } }
  @media (min-width: 1920px) { .stage-card { padding: 32px; gap: 40px; border-radius: 25px; } }

  .stage-card__media {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    background: var(--c-pale-gold);
  }
  @media (min-width: 1280px) { .stage-card__media { border-radius: 16px; } }
  .stage-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .stage-card__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    align-self: stretch;
    flex-grow: 1;
  }
  .stage-card__eyebrow { color: var(--c-cherrywood); align-self: stretch; }

  .stage-card__title {
    color: var(--c-cherrywood);
    font-family: 'ES Park', serif;
    font-weight: var(--weight-regular);
    font-size: var(--h2-size);
    line-height: 1.15;
    margin: 0;
    align-self: stretch;
  }
  @media (min-width: 1280px) { .stage-card__title { font-size: 32px; } }

  .stage-card__body { color: var(--c-cherrywood); font-size: var(--p1-size); line-height: 1.5; align-self: stretch; }

  .stage-card__cta { align-self: stretch; width: 100%; }
  .stage-card__cta :global(.btn) {
    width: 100%;
    height: 42px;
    min-height: 42px;
    padding: 10px;
    font-size: var(--button-size);
    line-height: 1.2;
    border-radius: 100px;
  }
  @media (min-width: 1024px) {
    .stage-card__cta :global(.btn) { height: 56px; min-height: 56px; padding: 18px; }
  }

  /* ============================================================
     OUTCOMES — "Was systemisches Aufstellen verändert."
     Mobile/tablet (<1024): two halves with separate curves (-1, -2)
     Desktop (≥1024): single process-curve.svg
     Desktop++ (≥1072): cards absolutely positioned per Figma
     ============================================================ */
  .outcomes {
    background: var(--c-spring-wood);
    padding: 64px 8px;
    overflow: hidden;
  }
  @media (min-width: 768px)  { .outcomes { padding: 96px 8px; } }
  @media (min-width: 1024px) { .outcomes { padding: 120px 8px; } }

  .outcomes__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 12px;
    max-width: 1106px;
    margin: 0 auto;
  }
  .outcomes__title { text-align: center; color: var(--c-cherrywood); margin: 0; }

  .outcomes__card-title {
    font-family: 'ES Park', serif;
    font-weight: var(--weight-regular);
    font-size: var(--h3-size);
    line-height: 1.2;
    color: var(--c-cherrywood);
    margin: 0;
  }
  .outcomes__card-body { color: var(--c-cherrywood); font-size: var(--p1-size); line-height: 1.5; }

  .outcomes__desktop { display: none; }
  .outcomes__mobile  { display: block; margin-top: 24px; }

  @media (min-width: 1024px) {
    .outcomes__desktop { display: block; margin-top: 32px; }
    .outcomes__mobile  { display: none; }
    .outcomes__curve { display: block; width: 100%; height: auto; margin: 0; }
  }

  @media (min-width: 1024px) and (max-width: 1071.98px) {
    .outcomes__cards {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
      padding: 0 90px;
      margin-top: 40px;
      min-height: 0;
      box-sizing: border-box;
    }
    .outcomes__card {
      position: static;
      width: auto;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      color: var(--c-cherrywood);
    }
  }

  @media (min-width: 1072px) {
    .outcomes {
      position: relative;
      --cv: min(100vw, 1920px);
      --cx: calc((100vw - var(--cv)) / 2);
      min-height: calc(0.68177 * var(--cv));
      padding: 120px 0;
    }
    .outcomes__header { max-width: 1106px; padding: 0 12px; margin: 0 auto; }

    .outcomes__desktop {
      position: static;
      width: 100%;
      max-width: 1920px;
      margin: 32px auto 0;
    }
    .outcomes__curve { max-width: none; }
    .outcomes__cards { position: static; display: block; padding: 0; margin: 0; }

    .outcomes__card {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(16px, 2.1vw, 40px);
      color: var(--c-cherrywood);
    }
    .outcomes__card--1 { left: calc(var(--cx) + 0.05000 * var(--cv)); top: calc(0.37344 * var(--cv)); width: calc(0.20104 * var(--cv)); }
    .outcomes__card--2 { left: calc(var(--cx) + 0.27552 * var(--cv)); top: calc(0.29792 * var(--cv)); width: calc(0.20104 * var(--cv)); }
    .outcomes__card--3 { left: calc(var(--cx) + 0.50677 * var(--cv)); top: calc(0.28958 * var(--cv)); width: calc(0.20000 * var(--cv)); }
    .outcomes__card--4 { left: calc(var(--cx) + 0.73698 * var(--cv)); top: calc(0.38177 * var(--cv)); width: calc(0.20000 * var(--cv)); }

    .outcomes__card-title { font-size: clamp(28px, 2.5vw, 48px); line-height: 1.15; }
    .outcomes__card-body  { font-size: clamp(16px, 1.2vw, 23px); line-height: 1.5; }
  }

  .outcomes__mobile-section { margin-top: 24px; }
  .outcomes__mobile-section:first-child { margin-top: 0; }

  .outcomes__mobile-curve {
    width: auto;
    aspect-ratio: 600 / 130;
    overflow: visible;
    margin-left: -8px;
    margin-right: -8px;
    padding: 0;
    box-sizing: content-box;
  }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .outcomes__mobile-curve { padding-top: 16px; }
  }
  .outcomes__mobile-curve img { display: block; width: 100%; height: 100%; }

  .outcomes__mobile-cards {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 16px 12px 0;
  }
  @media (min-width: 480px) and (max-width: 1023.98px) {
    .outcomes__mobile-cards {
      flex-direction: row;
      gap: 28px;
      padding: 24px 12px 0;
      align-items: flex-start;
    }
    .outcomes__mobile-cards > .outcomes__mobile-card {
      flex: 1 1 0;
      min-width: 0;
      max-width: calc(50% - 14px);
    }
  }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .outcomes__mobile-cards { gap: 44px; padding: 32px 44px 0; }
    .outcomes__mobile-cards > .outcomes__mobile-card { max-width: calc(50% - 22px); }
  }

  .outcomes__mobile-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    text-align: left;
    color: var(--c-cherrywood);
  }
  @media (min-width: 768px) { .outcomes__mobile-card { gap: 26.67px; } }

  /* ============================================================
     LEHRERIN — "Theresia Jansen" (portrait left, text right)
     ============================================================ */
  .lehrerin { background: var(--c-spring-wood); padding: 60px 20px; }
  @media (min-width: 768px)  { .lehrerin { padding: 80px 32px; } }
  @media (min-width: 1280px) { .lehrerin { padding: 90px 60px; } }
  @media (min-width: 1920px) { .lehrerin { padding: 90px; } }

  .lehrerin__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    max-width: 1740px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .lehrerin__inner { flex-direction: row; align-items: center; gap: 64px; }
  }
  @media (min-width: 1920px) { .lehrerin__inner { gap: 100px; } }

  .lehrerin__media {
    flex: 0 0 auto;
    width: 100%;
    overflow: hidden;
    border-radius: 16.67px;
    background: var(--c-pale-gold);
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 1024px) { .lehrerin__media { width: 46%; border-radius: 20px; } }
  @media (min-width: 1920px) { .lehrerin__media { width: 711px; border-radius: 25px; aspect-ratio: 711 / 826; } }
  .lehrerin__media img { width: 100%; height: 100%; object-fit: cover; display: block; }

