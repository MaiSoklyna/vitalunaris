---
/* Standalone layout for "Jawort by Jansen".
   Same head/SEO/tracking foundation as BaseLayout, but with its own reduced
   navigation and footer so the page stands on its own instead of presenting
   the full VitaLunaris site structure. */
import '@/styles/global.css';
import JawortNavigation from '@organisms/JawortNavigation.astro';
import JawortFooter from '@organisms/JawortFooter.astro';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Jawort by Jansen — freie Trauungen und Kinderwillkommensfeiern mit Herz, Tiefe und Persönlichkeit.',
  currentPath = Astro.url.pathname,
  ogImage = '/logo/logo.svg',
  noindex = false,
} = Astro.props;

/* Unter den eigenen Hochzeits-Domains ist die Seite ihre eigene Startseite:
   Canonical, OG-URL und Sitemap müssen dorthin zeigen — sonst weist Google
   die Adresse zurück auf vitalunaris.ch und die neue Domain rankt nicht.
   Läuft die Seite (noch) unter vitalunaris.ch, bleibt alles wie gehabt. */
const JAWORT_HOSTS = ['hochzeitsrednerin.ch', 'theresiajansen.ch'];
const reqHost = Astro.url.hostname.replace(/^www\./, '');
const onJawortDomain = JAWORT_HOSTS.includes(reqHost);

const siteBase = onJawortDomain
  ? 'https://hochzeitsrednerin.ch'
  : (Astro.site ?? new URL('https://vitalunaris.ch')).toString().replace(/\/$/, '');
/* Auf der eigenen Domain lebt die Seite unter "/", nicht unter /praxisangebote/... */
const canonicalPath = onJawortDomain ? '/' : currentPath;
const canonical = new URL(canonicalPath, siteBase + '/').toString();
const ogImageAbs = new URL(ogImage, siteBase + '/').toString();

/* Structured data scoped to the ceremony offering rather than the practice.
   Declared as a sub-brand of the VitaLunaris organization so search engines
   still connect the two. */
const jawortSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': siteBase + '/jawort-by-jansen#service',
  name: 'Jawort by Jansen',
  serviceType: 'Freie Trauungen und Kinderwillkommensfeiern',
  description:
    'Freie Trauungen, Kinderwillkommensfeiern und Eheversprechenerneuerungen mit Theresia Jansen — persönliche Zeremonien mit Herz, Humor und Feingefühl in der ganzen Deutschschweiz.',
  url: siteBase + '/jawort-by-jansen',
  areaServed: { '@type': 'Country', name: 'Schweiz' },
  provider: {
    '@type': 'Person',
    name: 'Theresia Jansen',
    email: 'info@vitalunaris.ch',
    telephone: '+41792917402',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Eichenaustrasse 32',
      postalCode: '9470',
      addressLocality: 'Buchs',
      addressRegion: 'SG',
      addressCountry: 'CH',
    },
    worksFor: { '@id': siteBase + '/#organization' },
  },
};

// Alchemy Scribe — first-party analytics; also drives auto-resize of embedded Alchemy form iframes.
const trackingApiUrl = import.meta.env.PUBLIC_TRACKING_API_URL || 'https://opus.alchemy.zuerich';
const trackingSiteId = import.meta.env.PUBLIC_TRACKING_SITE_ID || 'site_vitalunaris';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jawort by Jansen" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Structured data: ceremony service -->
    <script type="application/ld+json" set:html={JSON.stringify(jawortSchema)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/logo/logo-compact.svg" />

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/ESPark-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Preconnect to Alchemy (tracking + embedded forms) -->
    <link rel="preconnect" href="https://opus.alchemy.zuerich" />

    <!-- Alchemy Scribe — analytics + embedded-form iframe auto-resize -->
    <script define:vars={{ trackingApiUrl, trackingSiteId }}>
      (function (w, d, s, l) {
        w[l] = w[l] || [];
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s);
        j.async = true;
        j.src = trackingApiUrl + '/static/scribe.js';
        j.setAttribute('data-site-id', trackingSiteId);
        j.setAttribute('data-api-url', trackingApiUrl);
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'AlchemyScribe');
    </script>
  </head>
  <body>
    <JawortNavigation />
    <main id="content">
      <slot />
    </main>
    <JawortFooter />
  </body>
</html>
