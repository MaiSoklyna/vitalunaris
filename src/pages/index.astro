---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@organisms/Hero.astro';
import Blocks from '@organisms/Blocks.astro';
import { getEmDashEntry } from 'emdash';
import { imageUrl } from '@lib/cms';

// Home is a block page — editable at /_emdash/admin/content/pages (slug "home").
// Sections render through Blocks.astro; the fallback below keeps the page intact
// if the CMS row is ever cleared.
const { entry } = await getEmDashEntry('pages', 'home');
const d: Record<string, any> = entry?.data ?? {};

const FALLBACK_SECTIONS = [
  {
    type: 'offer_cards',
    title: 'Welchen Weg möchtest Du gehen?',
    items: [
      { icon: '/images/ebene/Ebene-14.svg', title: 'Ich will systemisch arbeiten', description: 'Für Dich selbst oder um andere zu begleiten. Drei Wege: Soulwork, die Soulcoach-Ausbildung und der SoulCircle.', ctaText: 'Systemisches Aufstellen →', ctaHref: '/ausbildung/uebersicht' },
      { icon: '/images/ebene/Ebene_2.svg', title: 'Ich will meine Praxis vertiefen oder Neues lernen', description: 'Kurse und Weiterbildungen rund um Aufstellen, Numerologie, EFT und Hypnotic Selfcare — praxisnah aus jahrzehntelanger Erfahrung.', ctaText: 'Zu den Workshops & Kursen →', ctaHref: '/workshops-kurse/kalender-uebersicht' },
      { icon: '/images/ebene/Ebene_2-8.svg', title: 'Ich suche Veränderung oder Unterstützung', description: 'Etwas fühlt sich nicht mehr stimmig an, ein Muster wiederholt sich oder eine Entscheidung steht an. Wir schauen gemeinsam hin.', ctaText: 'Unsere Praxisangebote →', ctaHref: '/praxisangebote' },
    ],
  },
  {
    type: 'narrative', tone: 'light', image_side: 'left', image: '/images/placeholder/Placeholder-6.jpg',
    title: 'Mehr als eine Praxis. <br/> Ein Ort wo Erfahrung auf Tiefe trifft.',
    body: 'VitaLunaris ist aus über 30 Jahren Erfahrung in der Begleitung von Menschen gewachsen. Ein Ort für alle, die verstehen möchten, warum sich manche Themen im Leben wiederholen, weshalb Beziehungen herausfordernd sein können oder was hinter den eigenen Herausforderungen und Lebenswegen wirkt – und für jene, die diese Arbeit selbst erlernen und weitergeben möchten.<br/><br/>Systemisches Aufstellen, Hypnose und Numerologie sind für uns keine Gegensätze. Sie sind verschiedene Wege, Zusammenhänge sichtbar zu machen, neue Perspektiven zu gewinnen und Veränderung möglich werden zu lassen.',
  },
  {
    type: 'narrative', tone: 'purple', image_side: 'right', image: '/images/placeholder/placeholder-3.jpg',
    title: '“VitaLunaris ist ein Raum, in dem Veränderung möglich werden darf. Ein Raum für neue Perspektiven, ehrliche Begegnungen und tiefe Prozesse – auf eine Weise, die zu Dir passt.”',
    body: 'Theresia & Axel Jansen · VitaLunaris',
  },
  {
    type: 'testimonials', eyebrow: 'Stimmen', title: 'Was Menschen sagen.',
    items: [
      { quote: '“Nach einer sehr schweren Zeit fand ich bei VitaLunaris einen geschützten Raum für meinen Weg. Durch die Begleitung von Theresia wurden Zusammenhänge sichtbar, die ich vorher nicht erkennen konnte. Schritt für Schritt fand ich zurück zu Vertrauen und neuer Lebensfreude.”', name: 'Claudia N.' },
      { quote: '“Ich stand vor einer wichtigen Entscheidung und war unsicher. Das Numeroskop von Axel hat mir neue Perspektiven eröffnet und mir geholfen, meine Stärken klarer zu erkennen. Heute weiss ich, dass ich die richtige Entscheidung getroffen habe.”', name: 'Erika B.' },
      { quote: '“Ich hätte nie gedacht, dass man mit ein bisschen Klopfen so viel erreichen kann. Schon nach dem EFT-Grundkurs konnte ich die Methode im Alltag anwenden. Eine echte Bereicherung für unsere ganze Familie.”', name: 'Ramona K.' },
      { quote: '“Die Ausbildung zum Systemic Soulcoach war für mich weit mehr als eine Ausbildung. Theresia hält einen unglaublich sicheren und vertrauensvollen Raum, sodass man sich wirklich auf die eigenen Prozesse einlassen kann.”', name: 'Corina B.' },
    ],
  },
  {
    type: 'faq', eyebrow: 'Fragen', title: 'Häufige Fragen.',
    items: [
      { question: 'Für wen ist VitaLunaris?', answer: 'Für Menschen, die spüren, dass etwas in Bewegung kommen will — und einen klaren, sicheren Rahmen suchen, um dorthin zu gehen. Ob in einer Lebensphase voller Fragen oder mitten in einer konkreten Veränderung.' },
      { question: 'Wie läuft eine erste Sitzung ab?', answer: 'Wir beginnen mit einem unverbindlichen Erstgespräch von 30 Minuten — online oder vor Ort. Du erzählst, was Dich bewegt, und wir klären gemeinsam, ob die Chemie stimmt und welcher Weg passt.' },
      { question: 'Wie viele Sitzungen brauche ich?', answer: 'Das ist sehr individuell. Manche Menschen kommen für eine einzelne Sitzung mit einem klaren Anliegen, andere begleiten wir über Monate. Im Erstgespräch finden wir gemeinsam heraus, was zu Dir passt.' },
      { question: 'Arbeitet ihr auch mit Paaren?', answer: 'Ja. Paarbegleitung ist ein eigener Schwerpunkt unserer Arbeit. Die Sitzungen folgen denselben Prinzipien — geschützter Raum, klare Sprache, Tiefe ohne Druck.' },
      { question: 'Werden die Kosten von der Krankenkasse übernommen?', answer: 'Wir sind keine Psychotherapeut:innen im medizinischen Sinn. Unsere Begleitung ist eine private Leistung und wird in der Regel nicht von der Krankenkasse gedeckt. Frag im Zweifelsfall Deine Zusatzversicherung.' },
    ],
  },
  {
    type: 'newsletter', eyebrow: 'Newsletter', title: 'Impulse für Deine<br />innere Reise.',
    body: 'Unser Newsletter ist kein gewöhnlicher Newsletter. Unsere Geschichten. Axels Zahlenmagie. Die feinen Impulse von Theresia. Mal humorvoll. Mal tiefgründig. Manchmal beides gleichzeitig.<br/><br/>Dazu neue Kurstermine, Podcast-Episoden, Inspirationen und kleine Einblicke hinter die Kulissen von VitaLunaris – direkt in Deiner Inbox.',
    items: { placeholder: 'E-mail adresse', submitText: 'Kostenlos abonnieren' },
  },
];

// Card lists + config now live in top-level fields (editable as labeled lists / fields —
// no JSON). Inject them into the matching section before Blocks renders.
const baseSections = d.sections?.length ? d.sections : FALLBACK_SECTIONS;
// Testimonials are resolved inside <Blocks/> from the shared collection via each
// section's `context` (the home section is tagged context="home").
const sections = baseSections.map((s: any) => {
  if (s.type === 'newsletter')
    return { ...s, items: { placeholder: d.newsletter_placeholder || 'E-mail adresse', submitText: d.newsletter_submit_text || 'Kostenlos abonnieren' } };
  // Inline lists edited directly on this page (no separate collection):
  if (s.type === 'faq' && d.faq_items?.length)
    return { ...s, items: d.faq_items };
  if (s.type === 'value_cards' && d.value_cards?.length)
    return { ...s, items: d.value_cards.map((c: any) => ({ icon: imageUrl(c.icon), title: c.title, body: c.body })) };
  return s;
});
---

<BaseLayout
  title={d.seo_title || 'VitaLunaris – Erforsche die Systeme der Seele'}
  description={d.seo_description || 'VitaLunaris in Buchs SG begleitet Dich in Tiefenarbeit, Integration und Transformation — mit klarem Vorgehen und geschützten Räumen.'}
  currentPath="/"
>
  <Hero
    eyebrow={d.hero_eyebrow || 'Systemische Praxis & Ausbildung · Buchs SG'}
    title={d.hero_title || "Erforsche die<br class='hero__br--md' /> Systeme der<br class='hero__br--md' />Seele"}
    subtitle={d.hero_subtitle || 'VitaLunaris ist Dein Ort für systemische Aufstellungsarbeit, Hypnose, Numerologie und persönliche Entwicklung. Hier verbinden sich systemisches Wissen, intuitive Wahrnehmung und die Erfahrung aus jahrzehntelanger Arbeit mit Menschen – getragen von Theresia und Axel Jansen.'}
    ctaText={d.hero_primary_cta_text || 'Systemisches Aufstellen'}
    ctaHref={d.hero_primary_cta_href || '/ausbildung/uebersicht'}
    secondaryCtaText={d.hero_secondary_cta_text || 'Praxisangebote'}
    secondaryCtaHref={d.hero_secondary_cta_href || '/praxisangebote'}
    image={imageUrl(d.hero_image) || '/images/placeholder/Placeholder_1.jpg'}
  />

  <Blocks sections={sections} />
</BaseLayout>
