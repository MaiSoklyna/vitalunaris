---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@organisms/Hero.astro';
import NarrativeBlock from '@organisms/NarrativeBlock.astro';
import InfoCardsRow from '@organisms/InfoCardsRow.astro';
import ProcessSteps from '@organisms/ProcessSteps.astro';
import CalendarBooking from '@organisms/CalendarBooking.astro';
import Faq from '@organisms/Faq.astro';
import TestimonialsBlock from '@organisms/TestimonialsBlock.astro';
import Heading from '@atoms/Heading.astro';
import Text from '@atoms/Text.astro';
import Button from '@atoms/Button.astro';

/* ----- "Wir schauen auf:" — outcomes arc (4 cards) ----- */
const outcomes = [
  {
    title: 'Beziehungen & Bindungsdynamiken',
    description: 'Wie gestalten wir Beziehungen — beruflich und privat? Was beeinflusst, wie wir uns verbinden, abgrenzen oder verlieren?',
  },
  {
    title: 'Eigene Muster & Loyalitäten',
    description: 'Warum wiederholen sich bestimmte Themen? Was steckt hinter den Entscheidungen, die wir immer wieder treffen?',
  },
  {
    title: 'Familiensysteme & Herkunft',
    description: 'Was haben wir mitbekommen? Was tragen wir — oft ohne es zu wissen? Loyalitäten, Verstrickungen und Muster, die sich durch Generationen ziehen.',
  },
  {
    title: 'Dein Platz im System',
    description: 'Wo stehst Du selbst — in Deiner Familie, in Deinen Beziehungen, in Deinem Leben? Was ist wirklich Deins, und was trägst Du für andere mit?',
  },
];

/* ----- Stimmen von Teilnehmer:innen — star reviews ----- */
const reviews = [
  {
    quote: '«Diese Arbeit hat mir eine völlig neue Perspektive eröffnet. Ich war lange eher im Kopf als im Körper — genau das beginnt sich zu verändern. Die Arbeit mit Familienkonstellationen hat mir geholfen, Klarheit zu gewinnen. Wo vorher Chaos war, entsteht heute mehr Ruhe und Vertrauen. Ich fühle mich mehr bei mir selbst angekommen.»',
    name: 'Jana L.',
  },
  {
    quote: '«In dieser Gruppe fühle ich mich so getragen, dass ich mit allem da sein kann, was ich bin. So habe ich mich in einer Gruppe noch nie gefühlt. In mir ist eine grosse Welle in Bewegung gekommen — früher hätte ich solche Gefühle verdrängt, heute gehe ich durch sie hindurch. Diese Arbeit ist für mich weit mehr als Lernen. Sie ist ein Raum für Heilung, Wachstum und echtes Menschsein.»',
    name: 'Silvia F.',
  },
  {
    quote: '«Diese Arbeit zeigt die Magie des systemischen Aufstellens — und ich könnte mir keinen Ort vorstellen, an dem ich mich wohler fühle. Ein geschützter Raum, in dem jede einfach sie selbst sein darf. Theresia schafft diesen Rahmen mit einer einfühlsamen Art, die es möglich macht, sich wirklich zu öffnen. Was diese Arbeit besonders macht: die Erfahrung, selbst Teil eines solchen Prozesses zu sein.»',
    name: 'Corina B.',
  },
];

/* ----- Die drei Module — aufeinander aufbauend, je ca. 1 Monat ----- */
const modules = [
  {
    number: '1',
    title: 'Modul 1',
    description: 'Der Einstieg: Grundhaltung, systemische Sprache und die ersten eigenen Aufstellungen. Du lernst das Handwerk kennen — und beginnst mit Deinem eigenen System.',
    color: 'purple' as const,
  },
  {
    number: '2',
    title: 'Modul 2',
    description: 'Wir gehen tiefer: Familiensysteme, Herkunft und die Muster, die sich durch Generationen ziehen. Was trägst Du mit, oft ohne es zu wissen?',
    color: 'raspberry' as const,
  },
  {
    number: '3',
    title: 'Modul 3',
    description: 'Die Integration: Bindungsdynamiken, eigene Loyalitäten und die Frage, wie Du das Erkannte in Deinen Alltag mitnimmst.',
    color: 'aurora' as const,
  },
];

/* ----- Was in jedem Modul enthalten ist ----- */
const moduleIncludes = [
  { eyebrow: 'Präsenztage', body: '2 pro Modul, vor Ort' },
  { eyebrow: 'Online-Nachmittage', body: '2 pro Modul' },
  { eyebrow: 'Dazwischen', body: 'Telegram-Gruppe zwischen den Terminen' },
  { eyebrow: 'Deine Aufstellungen', body: 'Garantiert 2 eigene Präsenz-Aufstellungen + mind. 1 online' },
];

/* ----- "Alles was Du wissen musst." — fact cards ----- */
const infoCards = [
  { eyebrow: 'Start', body: 'Zweimal jährlich — Februar und September' },
  { eyebrow: 'Aufbau', body: '3 Module à ca. 1 Monat' },
  { eyebrow: 'Durchführung', body: 'Hybrid — Präsenz + online, max. 6 Personen' },
  { eyebrow: 'Investition', body: 'Einzelmodul CHF 1’390.– · Paket CHF 3’800.–' },
];

/* ----- FAQ — first 4 fill the left column, next 4 the right ----- */
const faqItems = [
  { question: 'Muss ich alle drei Module buchen?', answer: 'Nein. Du startest mit Modul 1 und entscheidest danach, ob Du weitergehst. Wer gleich alle drei nimmt, zahlt CHF 370.– weniger.' },
  { question: 'Wann geht es los?', answer: 'Zweimal im Jahr, im Februar und im September. Modul 2 und 3 folgen in den Monaten danach — die genauen Daten bekommst Du im Gespräch.' },
  { question: 'Für wen ist das?', answer: 'Für alle, die sich selbst besser verstehen wollen. Du brauchst keinen fachlichen Hintergrund — nur Offenheit und die Bereitschaft, hinzuschauen.' },
  { question: 'Ist das eine Ausbildung?', answer: 'Nein. Systemic Soulwork ist Arbeit an Dir selbst. Wenn Du danach andere begleiten möchtest, ist der Systemic Soulcoach der nächste Schritt — muss aber nicht.' },
  { question: 'Wie läuft ein Modul ab?', answer: '2 Präsenztage, 2 Online-Nachmittage und eine Telegram-Gruppe dazwischen. Du hast garantiert 2 eigene Aufstellungen vor Ort und mindestens eine online.' },
  { question: 'Wie gross ist die Gruppe?', answer: 'Maximal 6 Personen. So bleibt für jede:n genug Raum.' },
  { question: 'Kann ich rein online teilnehmen?', answer: 'Nein. Jedes Modul hat 2 Präsenztage vor Ort — dort finden Deine eigenen Aufstellungen statt, und die lassen sich nicht ersetzen. Die 2 Nachmittage dazwischen sind online.' },
  { question: 'Was kostet es?', answer: 'Ein Modul CHF 1’390.–, alle drei im Paket CHF 3’800.– statt CHF 4’170.–. Ratenzahlung ist möglich.' },
  { question: 'Wie melde ich mich an?', answer: 'Immer über ein kostenloses Gespräch mit mir. 45 Minuten, unverbindlich — wir schauen gemeinsam, ob es passt und womit Du startest. Erst danach kommt die Anmeldung.' },
];
---

<BaseLayout
  title="Systemic Soulwork — Persönliche Entwicklung in 3 Modulen | VitaLunaris"
  description="Systemic Soulwork bei Theresia Jansen — persönliche Entwicklung in drei aufeinander aufbauenden Modulen. Einzeln buchbar ab CHF 1’390.– oder als Paket für CHF 3’800.–."
  currentPath="/ausbildung/soulcoach-level-1"
>
  <Hero
    eyebrow="Systemic Soulwork"
    title="Versteh Dich<br />endlich selbst."
    subtitle="Warum wiederholen sich bestimmte Dinge in Deinem Leben? Warum reagierst Du manchmal, obwohl Du eigentlich gar nicht willst?<br /><br />Systemic Soulwork ist keine Ausbildung — es ist Arbeit an Dir, mit dem systemischen Aufstellen als Werkzeug. Du schaust hin. Du verstehst. In drei Modulen."
    ctaText="Kostenloses Gespräch vereinbaren"
    ctaHref="#termin"
    image="/images/placeholder/Placeholder-9.jpg"
    imageFocus="center 15%"
  />

  {/* ===================== Narrative — lavender ===================== */}
  <NarrativeBlock
    tone="lavender-gradient"
    imageSide="left"
    image="/images/placeholder/Placeholder-10.jpg"
    imageAlt=""
    title="Manche Dinge versteht man nicht im Kopf. Sondern erst, wenn man sie sieht."
    body="Systemische Arbeit schaut nicht auf die Person allein — sondern auf das System dahinter. Die Familie, die Geschichte, die Muster die von Generation zu Generation weitergehen.<br /><br />In einer Aufstellung wird sichtbar, was sonst unsichtbar bleibt. Du siehst Dein eigenes System vor Dir stehen — und plötzlich ergibt Sinn, was sich jahrelang wie ein Rätsel angefühlt hat.<br /><br />Manche kommen, weil eine bestimmte Beziehung nicht mehr weitergeht. Manche, weil sich ein Muster hartnäckig wiederholt. Andere einfach, weil sie spüren: Da ist etwas, das Aufmerksamkeit braucht. Alle drei Gründe sind gute Gründe."
  />

  {/* ===================== Wir schauen auf: — outcomes arc ===================== */}
  <section class="outcomes">
    <header class="outcomes__header">
      <Heading level={2} variant="h1" class="outcomes__title">Worauf wir gemeinsam schauen:</Heading>
    </header>

    {/* Desktop (≥1024px): single curve + absolutely positioned cards at ≥1072 */}
    <div class="outcomes__desktop">
      <img src="/images/ebene/process-curve.svg" alt="" class="outcomes__curve" />
      <div class="outcomes__cards">
        {outcomes.map((o, i) => (
          <article class={`outcomes__card outcomes__card--${i + 1}`}>
            <Heading level={3} class="outcomes__card-title">{o.title}</Heading>
            <Text size="p1" class="outcomes__card-body">{o.description}</Text>
          </article>
        ))}
      </div>
    </div>

    {/* Mobile/tablet (<1024px): two halves, each with its own curve + 2 cards */}
    <div class="outcomes__mobile">
      {[0, 2].map((startIdx) => (
        <div class="outcomes__mobile-section">
          <div class="outcomes__mobile-curve">
            <img
              src={startIdx === 0 ? '/images/ebene/process-curve-1.svg' : '/images/ebene/process-curve-2.svg'}
              alt=""
            />
          </div>
          <div class="outcomes__mobile-cards">
            {outcomes.slice(startIdx, startIdx + 2).map((o) => (
              <article class="outcomes__mobile-card">
                <Heading level={3} class="outcomes__card-title">{o.title}</Heading>
                <Text size="p1" class="outcomes__card-body">{o.description}</Text>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="outcomes__cta">
      <Button href="#termin" variant="primary" size="lg">Kostenloses Gespräch vereinbaren</Button>
    </div>
  </section>

  {/* ===================== Was Dich nach den drei Modulen erwartet ===================== */}
  <NarrativeBlock
    tone="light"
    imageSide="left"
    image="/images/placeholder/placeholder-3.jpg"
    imageAlt=""
    title="Was sich verändert"
    body="Die meisten sehen sich selbst, ihre Beziehungen und ihre Geschichte danach mit anderen Augen. Was vorher verwirrend war oder sich endlos wiederholt hat, wird verständlicher und leichter. Mehr Vertrauen in Dich. Mehr Ruhe, wenn es schwierig wird. Und das Gefühl, Deinem eigenen Weg wieder näher zu sein."
  />

  {/* ===================== Stimmen ===================== */}
  <TestimonialsBlock title="Was andere erlebt haben" testimonials={reviews} />

  <div id="module"></div>
  {/* ===================== Der Aufbau — 3 Module ===================== */}
  <ProcessSteps
    eyebrow="Der Aufbau"
    title="Drei Module"
    intro="Jedes Modul dauert rund einen Monat und baut auf dem vorherigen auf. Du startest mit Modul 1 — einzeln buchbar oder gleich alle drei."
    steps={modules}
  />

  {/* ===================== Was in jedem Modul steckt ===================== */}
  <section class="wissen">
    <div class="wissen__inner">
      <Heading level={2} variant="h1" class="wissen__title">Was in jedem Modul steckt.</Heading>
    </div>
  </section>

  <InfoCardsRow cards={moduleIncludes} />

  {/* ===================== Preise ===================== */}
  <section class="preise">
    <div class="preise__inner">
      <header class="preise__header">
        <Heading variant="eyebrow" class="preise__eyebrow">Investition</Heading>
        <Heading level={2} variant="h1" class="preise__title">Einzeln einsteigen oder den ganzen Weg gehen.</Heading>
      </header>

      <div class="preise__cards">
        <article class="preise__card">
          <Heading level={3} class="preise__card-title">Einzelmodul</Heading>
          <p class="preise__price">CHF 1’390.–</p>
          <Text size="p1" class="preise__card-body">
            Pro Modul. Steig ein, schau ob es passt — und entscheide danach weiter.
          </Text>
        </article>

        <article class="preise__card preise__card--featured">
          <span class="preise__badge">Du sparst CHF 370.–</span>
          <Heading level={3} class="preise__card-title">Alle 3 Module</Heading>
          <p class="preise__price">CHF 3’800.–</p>
          <p class="preise__strike">statt CHF 4’170.– bei Einzelbuchung</p>
          <Text size="p1" class="preise__card-body">
            Alle drei Module, von Anfang an. Dein Platz ist sicher — und Du zahlst weniger.
          </Text>
        </article>
      </div>

      <div class="preise__cta">
        <Button href="#termin" variant="primary" size="lg">Kostenloses Gespräch vereinbaren</Button>
        <Text size="p3" class="preise__note">
          Jede Anmeldung beginnt mit einem Gespräch — 45 Minuten, unverbindlich. Danach entscheidest Du in Ruhe, welches Modul es wird. Ratenzahlung möglich.
        </Text>
      </div>
    </div>
  </section>

  {/* ===================== Theresia Jansen — gold, image right ===================== */}
  <section class="lehrerin">
    <div class="lehrerin__inner">
      <div class="lehrerin__content">
        <Heading variant="eyebrow" class="lehrerin__eyebrow">Theresia Jansen</Heading>
        <Heading level={2} variant="h1" class="lehrerin__name">Wer Dich begleitet.</Heading>
        <Text size="p1" class="lehrerin__body">
          Über 30 Jahre systemische Praxis mit echten Menschen in der Deutschschweiz — nicht angelesen, sondern selbst durchlebt und erprobt.
        </Text>
        <Text size="p1" class="lehrerin__body">
          In der Gruppe halte ich den Raum: ruhig, präsent und mit dem Blick für das, was gerade dran ist.
        </Text>
      </div>
      <div class="lehrerin__media">
        <img src="/images/placeholder/Placeholder-8.jpg" alt="Theresia Jansen" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {/* ===================== In drei Schritten zu Deinem Platz ===================== */}
  <ProcessSteps
    title="So kommst Du rein"
    steps={[
      { number: '1', title: 'Gespräch', description: '45 Minuten miteinander, kostenlos und unverbindlich. Du erzählst, wo Du stehst — gemeinsam schauen wir, ob und womit Du starten möchtest.', color: 'purple' },
      { number: '2', title: 'Anmeldung', description: 'Wenn es für uns beide stimmt, sicherst Du Dir Deinen Platz und bekommst alle Termine und Unterlagen.', color: 'raspberry' },
      { number: '3', title: 'Loslegen', description: 'Du startest in der Gruppe — 2 Tage vor Ort, 2 Nachmittage online.', color: 'aurora' },
    ]}
    ctaText="Kostenloses Gespräch vereinbaren"
    ctaHref="#termin"
  />

  {/* ===================== Alles was Du wissen musst. ===================== */}
  <section class="wissen">
    <div class="wissen__inner">
      <Heading level={2} variant="h1" class="wissen__title">Alles was Du wissen musst.</Heading>
    </div>
  </section>

  <InfoCardsRow cards={infoCards} />

  <section class="wissen-foot">
    <div class="wissen-foot__inner">
      <Text size="p1" class="wissen-foot__caption">Jedes Modul verbindet 2 Präsenztage vor Ort mit 2 Online-Nachmittagen. Die Präsenztage sind fester Bestandteil — dort stellst Du auf.<br />Wir starten zweimal im Jahr, im Februar und im September — die genauen Daten besprechen wir im Gespräch.</Text>
      <div class="wissen-foot__cta">
        <Button href="#termin" variant="primary" size="lg" class="wissen-foot__btn">Kostenloses Gespräch vereinbaren</Button>
      </div>
    </div>
  </section>

  {/* ===================== Termin buchen ===================== */}
  <CalendarBooking
    slug="soulcoach-level-1-gespraech"
    eyebrow="Der erste Schritt"
    title="Lass uns sprechen"
    intro="Jede Anmeldung beginnt hier: 45 Minuten, kostenlos und unverbindlich. Wir schauen gemeinsam, ob und womit Du starten möchtest."
  />

  {/* ===================== FAQ ===================== */}
  <Faq title="FAQ" items={faqItems} />

  {/* ===================== Infoanlass — dark CTA with form ===================== */}
  <section class="infoanlass">
    <div class="infoanlass__card">
      <div class="infoanlass__content">
        <Heading variant="eyebrow" class="infoanlass__eyebrow">Infoanlass</Heading>
        <Heading level={2} variant="h1" class="infoanlass__title">Komm zum<br />nächsten Infoanlass.</Heading>
        <Text size="p1" class="infoanlass__body">Ein kostenloser Online-Abend via Zoom: ehrlicher Einblick in die Arbeit, den Aufbau — und Raum für Deine Fragen.</Text>
        <a href="/ausbildung/infoanlaesse#anmelden" class="infoanlass__submit infoanlass__cta">Zum Infoanlass anmelden</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     OUTCOMES — "Wir schauen auf:" (dome arc, 4 cards + CTA)
     Mobile/tablet (<1024): two halves with separate curves (-1, -2)
     Desktop (≥1024): single process-curve.svg
     Desktop++ (≥1072): cards + CTA absolutely positioned per Figma
     ============================================================ */
  .outcomes {
    background: var(--c-spring-wood);
    padding: 64px 8px;
    overflow: hidden;
  }
  @media (min-width: 768px)  { .outcomes { padding: 96px 8px; } }
  @media (min-width: 1024px) { .outcomes { padding: 120px 8px; } }

  .outcomes__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 12px;
    max-width: 1106px;
    margin: 0 auto;
  }
  .outcomes__title { text-align: center; color: var(--c-cherrywood); margin: 0; }

  .outcomes__card-title {
    font-family: 'ES Park', serif;
    font-weight: var(--weight-regular);
    font-size: var(--h3-size);
    line-height: 1.2;
    color: var(--c-cherrywood);
    margin: 0;
  }
  .outcomes__card-body { color: var(--c-cherrywood); font-size: var(--p1-size); line-height: 1.5; }

  .outcomes__cta {
    display: flex;
    justify-content: center;
    padding: 24px 12px 0;
  }

  .outcomes__desktop { display: none; }
  .outcomes__mobile  { display: block; margin-top: 24px; }

  @media (min-width: 1024px) {
    .outcomes__desktop { display: block; margin-top: 32px; }
    .outcomes__mobile  { display: none; }
    .outcomes__curve { display: block; width: 100%; height: auto; margin: 0; }
  }

  @media (min-width: 1024px) and (max-width: 1071.98px) {
    .outcomes__cards {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
      padding: 0 90px;
      margin-top: 40px;
      min-height: 0;
      box-sizing: border-box;
    }
    .outcomes__card {
      position: static;
      width: auto;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      color: var(--c-cherrywood);
    }
  }

  @media (min-width: 1072px) {
    .outcomes {
      position: relative;
      --cv: min(100vw, 1920px);
      --cx: calc((100vw - var(--cv)) / 2);
      min-height: calc(0.68177 * var(--cv));
      padding: 120px 0;
    }
    .outcomes__header { max-width: 1106px; padding: 0 12px; margin: 0 auto; }

    .outcomes__desktop {
      position: static;
      width: 100%;
      max-width: 1920px;
      margin: 32px auto 0;
    }
    .outcomes__curve { max-width: none; }
    .outcomes__cards { position: static; display: block; padding: 0; margin: 0; }

    .outcomes__card {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(16px, 2.1vw, 40px);
      color: var(--c-cherrywood);
    }
    .outcomes__card--1 { left: calc(var(--cx) + 0.05000 * var(--cv)); top: calc(0.37344 * var(--cv)); width: calc(0.20104 * var(--cv)); }
    .outcomes__card--2 { left: calc(var(--cx) + 0.27552 * var(--cv)); top: calc(0.29792 * var(--cv)); width: calc(0.20104 * var(--cv)); }
    .outcomes__card--3 { left: calc(var(--cx) + 0.50677 * var(--cv)); top: calc(0.28958 * var(--cv)); width: calc(0.20000 * var(--cv)); }
    .outcomes__card--4 { left: calc(var(--cx) + 0.73698 * var(--cv)); top: calc(0.38177 * var(--cv)); width: calc(0.20000 * var(--cv)); }

    .outcomes__card-title { font-size: clamp(24px, 2.1vw, 40px); line-height: 1.15; }
    .outcomes__card-body  { font-size: clamp(16px, 1.2vw, 23px); line-height: 1.5; }

    .outcomes__cta {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      top: calc(0.59583 * var(--cv));
      padding: 0;
      justify-content: center;
    }
  }

  .outcomes__mobile-section { margin-top: 24px; }
  .outcomes__mobile-section:first-child { margin-top: 0; }

  .outcomes__mobile-curve {
    width: auto;
    aspect-ratio: 600 / 130;
    overflow: visible;
    margin-left: -8px;
    margin-right: -8px;
    padding: 0;
    box-sizing: content-box;
  }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .outcomes__mobile-curve { padding-top: 16px; }
  }
  .outcomes__mobile-curve img { display: block; width: 100%; height: 100%; }

  .outcomes__mobile-cards {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 16px 12px 0;
  }
  @media (min-width: 480px) and (max-width: 1023.98px) {
    .outcomes__mobile-cards {
      flex-direction: row;
      gap: 28px;
      padding: 24px 12px 0;
      align-items: flex-start;
    }
    .outcomes__mobile-cards > .outcomes__mobile-card {
      flex: 1 1 0;
      min-width: 0;
      max-width: calc(50% - 14px);
    }
  }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .outcomes__mobile-cards { gap: 44px; padding: 32px 44px 0; }
    .outcomes__mobile-cards > .outcomes__mobile-card { max-width: calc(50% - 22px); }
  }

  .outcomes__mobile-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    text-align: left;
    color: var(--c-cherrywood);
  }
  @media (min-width: 768px) { .outcomes__mobile-card { gap: 26.67px; } }

  /* ============================================================
     LEHRERIN — "Theresia Jansen" (Pale Gold, text left / image right)
     ============================================================ */
  .lehrerin { background: var(--c-pale-gold); padding: 60px 20px; }
  @media (min-width: 768px)  { .lehrerin { padding: 80px 32px; } }
  @media (min-width: 1280px) { .lehrerin { padding: 90px 60px; } }
  @media (min-width: 1920px) { .lehrerin { padding: 90px; } }

  .lehrerin__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    max-width: 1740px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) { .lehrerin__inner { flex-direction: row; align-items: center; gap: 64px; } }
  @media (min-width: 1920px) { .lehrerin__inner { gap: 100px; } }

  .lehrerin__media {
    flex: 0 0 auto;
    width: 100%;
    overflow: hidden;
    border-radius: 16.67px;
    background: rgba(96, 29, 29, 0.06);
    aspect-ratio: 4 / 5;
    order: -1;
  }
