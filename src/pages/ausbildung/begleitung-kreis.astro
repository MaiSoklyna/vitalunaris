---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@organisms/Hero.astro';
import NarrativeBlock from '@organisms/NarrativeBlock.astro';
import InfoCardsRow from '@organisms/InfoCardsRow.astro';
import Heading from '@atoms/Heading.astro';
import Text from '@atoms/Text.astro';
import Button from '@atoms/Button.astro';

/* ----- "Alles was Du wissen musst." — fact cards ----- */
const infoCards = [
  { eyebrow: 'Rhythmus', body: 'Einmal im Monat, online' },
  { eyebrow: 'Dazwischen', body: 'Telegram-Gruppe' },
  { eyebrow: 'Einstieg', body: 'Jederzeit — ab dem 1. Soulwork-Modul' },
  { eyebrow: 'Investition', body: 'CHF 130.– pro Monat' },
];
---

<BaseLayout
  title="Systemic SoulCircle — monatlich dranbleiben | VitaLunaris"
  description="Der Systemic SoulCircle: einmal im Monat online zusammenkommen — ein Thema, kleine Aufstellungen, Impulse und Übungen. Dazwischen über Telegram verbunden. CHF 130.– pro Monat, jederzeit kündbar."
  currentPath="/ausbildung/begleitung-kreis"
>
  <Hero
    eyebrow="Systemic SoulCircle"
    title="Dranbleiben,<br />ohne allein zu sein."
    subtitle="Nach einem Modul ist vieles in Bewegung — und dann? Im SoulCircle kommen wir einmal im Monat online zusammen: ein Thema, kleine Aufstellungen, Impulse und Übungen. Dazwischen bleiben wir über Telegram verbunden.<br /><br />Kein neuer Kurs, den Du Dir überlegen musst. Ein Ort, an dem Du einfach weiter dabei bist."
    ctaText="Interesse anmelden"
    ctaHref="#anmelden"
    image="/images/placeholder/Placeholder-9.jpg"
    imageFocus="center 15%"
  />

  {/* ===================== Narrative — lavender gradient ===================== */}
  <NarrativeBlock
    tone="lavender-gradient"
    imageSide="left"
    image="/images/placeholder/Placeholder-12.jpg"
    imageAlt=""
    title="Was in Bewegung kam, darf weitergehen."
    body="Ein Modul endet, Du gehst nach Hause — und das, was sich gerade geöffnet hat, läuft weiter. Genau dort setzt der SoulCircle an.<br /><br />Einmal im Monat kommen wir online zusammen. Wir schauen auf ein Thema, machen kleine Aufstellungen, Du bekommst Impulse und Übungen für den Alltag. Zwischen den Treffen bleiben wir über Telegram in Kontakt — für Fragen, kurze Rückmeldungen und das Gefühl, nicht allein damit zu sein.<br /><br />Kein Leistungsdruck, keine Hausaufgaben. Du kommst, wenn Du kannst, und steigst aus, wann Du willst."
    bulletGroups={[
      {
        heading: 'Jeden Monat:',
        items: [
          'Ein Online-Treffen zu einem bestimmten Thema',
          'Kleine Aufstellungen in der Gruppe',
          'Impulse und Übungen für zwischendurch',
          'Telegram-Gruppe für die Zeit dazwischen',
          'Austausch mit Menschen, die denselben Weg gehen',
        ],
      },
    ]}
  />

  {/* ===================== Theresia Jansen — gold, image right ===================== */}
  <section class="lehrerin">
    <div class="lehrerin__inner">
      <div class="lehrerin__content">
        <Heading variant="eyebrow" class="lehrerin__eyebrow">Theresia Jansen</Heading>
        <Heading level={2} variant="h1" class="lehrerin__name">Ich bleibe an Deiner Seite.</Heading>
        <Text size="p1" class="lehrerin__body">
          Ich begleite seit über 30 Jahren Menschen in systemischer Arbeit und Heilkunde — gelebte Praxis aus der Deutschschweiz, nicht angelesen.
        </Text>
        <Text size="p1" class="lehrerin__body">
          Der SoulCircle ist mein Weg, dranzubleiben: Ich bringe jeden Monat ein Thema mit, nehme Deine Fragen auf und halte den Raum — auch für das, was zwischen den Treffen auftaucht.
        </Text>
      </div>
      <div class="lehrerin__media">
        <img src="/images/placeholder/placeholder-4.jpg" alt="Theresia Jansen" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {/* ===================== Alles was Du wissen musst. ===================== */}
  <section class="wissen">
    <div class="wissen__inner">
      <Heading level={2} variant="h1" class="wissen__title">Alles was Du wissen musst.</Heading>
    </div>
  </section>

  <InfoCardsRow cards={infoCards} />

  <section class="wissen-foot">
    <div class="wissen-foot__inner">
      <Text size="p1" class="wissen-foot__caption">
        Offen für alle, die mindestens ein Soulwork-Modul gemacht haben — und für Absolventinnen der Soulcoach-Ausbildung.<br />
        Monatlich kündbar, ohne Mindestlaufzeit.
      </Text>
      <div class="wissen-foot__cta">
        <Button href="#anmelden" variant="primary" size="lg" class="wissen-foot__btn">Interesse anmelden</Button>
      </div>
    </div>
  </section>

  {/* ===================== Vormerkung =====================
       ÜBERGANGSLÖSUNG: Das Abo-Formular (embed zqE5fhFrIUKuzMPKSKpe1Q,
       verknüpft mit dem Abo-Produkt 8431af0a…) löst im Labs-Backend
       keine Zahlung aus — der Formular-Submit startet den Checkout nur
       bei `one_time`-Produkten, bei `subscription` gibt er redirect_url
       null zurück. Bis das behoben ist, sammelt hier ein reines
       Interessenten-Formular ohne Produkt. Danach: diesen Block wieder
       auf das Abo-Formular zurückstellen. */}
  <section class="circle-form" id="anmelden">
    <div class="circle-form__inner">
      <div class="circle-form__head">
        <Heading variant="eyebrow" class="circle-form__eyebrow">Bald verfügbar</Heading>
        <Heading level={2} variant="h1" class="circle-form__title">Sei von Anfang an dabei</Heading>
        <Text size="p1" class="circle-form__intro">
          Der SoulCircle startet in Kürze. Trag Dich ein, dann melden wir uns bei Dir, sobald es losgeht — unverbindlich und kostenlos.
        </Text>
      </div>

      <div class="circle-form__frame-wrap">
        <iframe
          class="circle-form__frame"
          src="https://opus.alchemy.zuerich/api/f/8nHloAh5JQ7JssLnN276sg/page"
          title="Interesse Systemic SoulCircle"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     LEHRERIN — "Theresia Jansen" (Pale Gold, text left / image right)
     ============================================================ */
  .lehrerin { background: var(--c-pale-gold); padding: 60px 20px; }
  @media (min-width: 768px)  { .lehrerin { padding: 80px 32px; } }
  @media (min-width: 1280px) { .lehrerin { padding: 90px 60px; } }
  @media (min-width: 1920px) { .lehrerin { padding: 90px; } }

  .lehrerin__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    max-width: 1740px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) { .lehrerin__inner { flex-direction: row; align-items: center; gap: 64px; } }
  @media (min-width: 1920px) { .lehrerin__inner { gap: 100px; } }

  .lehrerin__media {
    flex: 0 0 auto;
    width: 100%;
    overflow: hidden;
    border-radius: 16.67px;
    background: rgba(96, 29, 29, 0.06);
    aspect-ratio: 4 / 5;
    order: -1;
  }
  @media (min-width: 1024px) { .lehrerin__media { width: 46%; border-radius: 20px; order: 0; } }
  @media (min-width: 1920px) { .lehrerin__media { width: 683px; border-radius: 25px; aspect-ratio: 683 / 830; } }
  .lehrerin__media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .lehrerin__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
    flex: 1 1 auto;
    min-width: 0;
  }
  @media (min-width: 1024px) { .lehrerin__content { gap: 26.67px; } }
  @media (min-width: 1920px) { .lehrerin__content { gap: 40px; max-width: 820px; } }

  .lehrerin__eyebrow { color: var(--c-cherrywood); }
  .lehrerin__name {
    color: var(--c-cherrywood);
    font-family: 'ES Park', serif;
    font-weight: var(--weight-regular);
    font-size: var(--h2-size);
    line-height: 1.1;
    margin: 0;
  }
  @media (min-width: 1920px) { .lehrerin__name { font-size: 60px; line-height: 1.1; } }
  .lehrerin__body { color: var(--c-cherrywood); font-size: var(--p1-size); line-height: 1.5; }

  /* ============================================================
     WISSEN — "Alles was Du wissen musst." (header + cards + footer)
     ============================================================ */
  .wissen { background: var(--c-spring-wood); padding: 60px 20px 32px; }
  @media (min-width: 768px)  { .wissen { padding: 80px 32px 40px; } }
  @media (min-width: 1280px) { .wissen { padding: 90px 60px 48px; } }
  @media (min-width: 1920px) { .wissen { padding: 120px 90px 64px; } }

  .wissen__inner { max-width: 1740px; margin: 0 auto; }
  .wissen__title { color: var(--c-cherrywood); text-align: center; margin: 0; }

  .wissen-foot { background: var(--c-spring-wood); padding: 8px 20px 60px; }
  @media (min-width: 768px)  { .wissen-foot { padding: 8px 32px 80px; } }
  @media (min-width: 1280px) { .wissen-foot { padding: 8px 60px 90px; } }
  @media (min-width: 1920px) { .wissen-foot { padding: 8px 90px 120px; } }

  .wissen-foot__inner {
    max-width: 1740px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }
  .wissen-foot__caption { color: var(--c-cherrywood); text-align: center; }

  .wissen-foot__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
  }
  @media (min-width: 640px) { .wissen-foot__cta { flex-direction: row; justify-content: center; gap: 20px; } }
  /* Only constrain the width on narrow screens — size and padding come from
     the shared .btn--lg token so every button on the site matches. */
  .wissen-foot__cta :global(.btn) {
    width: 100%;
    max-width: 350px;
  }
  @media (min-width: 640px) {
    /* Drop the cap too — otherwise a long label keeps hitting 320px and the
       40px side padding gets squeezed even though the token still says 40px. */
    .wissen-foot__cta :global(.btn) { width: auto; max-width: none; }
  }

  /* ============================================================
     CIRCLE FORM — Mockup-Anmeldung (Platzhalter, sendet nicht)
     ============================================================ */
  .circle-form { background: var(--c-spring-wood); padding: 60px 20px; scroll-margin-top: 100px; }
  @media (min-width: 768px)  { .circle-form { padding: 80px 32px; } }
  @media (min-width: 1280px) { .circle-form { padding: 90px 60px; } }

  .circle-form__inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .circle-form__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  .circle-form__eyebrow { color: var(--c-cherrywood); }
  .circle-form__title { color: var(--c-cherrywood); margin: 0; }
  .circle-form__intro { color: var(--c-cherrywood); margin: 0; }

  .circle-form__frame-wrap { width: 100%; }
  .circle-form__frame {
    width: 100%;
    height: 520px;          /* sensible default before Scribe sizes it */
    min-height: 420px;
    border: 0;
    display: block;
    transition: height 200ms ease;
  }

</style>
